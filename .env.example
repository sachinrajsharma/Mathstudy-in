# Server
PORT=3001
NODE_ENV=development
BASE_URL=https://mathstudy.in

# Session
SESSION_SECRET=change-this-to-a-long-random-string

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_password
DB_NAME=mathstudy

# Email (SMTP — order + payment-confirmation emails to buyer & admin)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
MAIL_FROM="MathStudy.in <admin@mathstudy.in>"

# Admin (receives new-order emails with Approve/Reject links + is the admin login)
ADMIN_EMAIL=admin@mathstudy.in
# Admin login password used by scripts/setup-db.js when first creating the admin.
# Leave blank to have a strong random password generated and printed once at setup.
# You can change it any time after login at /account/password.
ADMIN_PASSWORD=

# Payments: manual UPI — buyer pays to your UPI ID and taps "I've paid";
# you verify in your UPI app and Approve via the link in the order email.
# (No Razorpay / payment-gateway credentials required.)

# WhatsApp: free click-to-chat only (a wa.me link in the UI). No API key needed.
# To change the number, edit it in views/contact.ejs, views/layout.ejs and views/blog-post.ejs.
