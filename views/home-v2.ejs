<script>
(function(){
  // mobile drawer
  var drawer=document.getElementById('drawer'),burger=document.getElementById('burger');
  function setDrawer(open){drawer.classList.toggle('open',open);burger.setAttribute('aria-expanded',open);document.body.style.overflow=open?'hidden':''}
  burger.addEventListener('click',function(){setDrawer(true)});
  document.getElementById('drawerClose').addEventListener('click',function(){setDrawer(false)});
  document.getElementById('drawerScrim').addEventListener('click',function(){setDrawer(false)});
  document.addEventListener('keydown',function(e){if(e.key==='Escape')setDrawer(false)});

  // floating chalk formulas
  var motes=['π','∑','√x','∫','Δ','θ','∞','a²+b²','x→0','φ','∂y/∂x','≡','7!','sinθ'];
  var frag=document.createDocumentFragment();
  for(var i=0;i<16;i++){
    var m=document.createElement('span');
    m.className='mote';
    m.textContent=motes[i%motes.length];
    m.style.left=(Math.random()*98)+'vw';
    m.style.top=(100+Math.random()*10)+'vh';
    m.style.fontSize=(1.1+Math.random()*2.4)+'rem';
    m.style.animationDuration=(34+Math.random()*40)+'s';
    m.style.animationDelay=(-Math.random()*60)+'s';
    frag.appendChild(m);
  }
  document.body.appendChild(frag);

  // scroll reveal
  var io=new IntersectionObserver(function(es){
    es.forEach(function(e){ if(e.isIntersecting){ e.target.classList.add('in'); io.unobserve(e.target);} });
  },{threshold:.12});
  document.querySelectorAll('.rv').forEach(function(el){ io.observe(el); });

  // animated counters
  var cio=new IntersectionObserver(function(es){
    es.forEach(function(e){
      if(!e.isIntersecting) return;
      var el=e.target, target=+el.dataset.count, plus=el.dataset.plus, pct=el.dataset.pct;
      var t0=null;
      function tick(ts){
        if(!t0) t0=ts;
        var k=Math.min(1,(ts-t0)/1400);
        var v=Math.round(target*(1-Math.pow(1-k,3)));
        el.textContent=v.toLocaleString('en-IN')+(pct?'%':'')+(plus?'+':'');
        if(k<1) requestAnimationFrame(tick);
      }
      requestAnimationFrame(tick);
      cio.unobserve(el);
    });
  },{threshold:.6});
  document.querySelectorAll('[data-count]').forEach(function(el){ cio.observe(el); });

  // gentle 3D tilt on book cards
  document.querySelectorAll('.tome').forEach(function(card){
    card.addEventListener('mousemove',function(ev){
      var r=card.getBoundingClientRect();
      var rx=((ev.clientY-r.top)/r.height-.5)*-7;
      var ry=((ev.clientX-r.left)/r.width-.5)*9;
      card.style.transform='translateY(-8px) rotateX('+rx+'deg) rotateY('+ry+'deg)';
    });
    card.addEventListener('mouseleave',function(){ card.style.transform=''; });
  });
})();
</script>
