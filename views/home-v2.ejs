<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="index, follow">
<title><%= title %></title>
<meta name="description" content="<%= metaDesc %>">
<% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:title"       content="<%= title %>">
<meta property="og:description" content="<%= metaDesc %>">
<meta property="og:type"        content="website">
<% if (locals.canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
<%
  // Social crawlers ignore a relative og:image, so always emit an absolute URL.
  const _img  = locals.ogImage || '/images/og-default.png';
  const _site = locals.SITE_URL || 'https://mathstudy.in';
  const ogImageAbs = /^https?:\/\//i.test(_img) ? _img : _site + (_img.charAt(0) === '/' ? _img : '/' + _img);
%>
<meta property="og:image"       content="<%= ogImageAbs %>">
<meta property="og:site_name"   content="MathStudy.in">
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="<%= title %>">
<meta name="twitter:description" content="<%= metaDesc %>">
<meta name="twitter:image"       content="<%= ogImageAbs %>">
<%- locals.siteJsonLd || '' %>
<!-- Google Analytics 4 (live property) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-YWL5E4YY59"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-YWL5E4YY59');</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..900;1,9..144,300..900&family=Space+Grotesk:wght@300..700&display=swap" rel="stylesheet">
<style>
:root{
  --bg:#05070d; --bg2:#0a0e1a; --ink:#e9edf8; --dim:#9aa3bc; --line:rgba(255,255,255,.09);
  --glass:rgba(255,255,255,.045); --mint:#7ee8c7; --amber:#ffc466; --violet:#a78bfa; --rose:#fb7185;
  --disp:'Fraunces',Georgia,serif; --ui:'Space Grotesk',system-ui,sans-serif;
}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--bg);color:var(--ink);font-family:var(--ui);overflow-x:hidden;line-height:1.6}
a{color:inherit;text-decoration:none}
::selection{background:var(--mint);color:#04281d}

/* ── animated cosmos backdrop ── */
.cosmos{position:fixed;inset:0;z-index:-2;overflow:hidden;background:
  radial-gradient(1100px 700px at 85% -10%, rgba(167,139,250,.14), transparent 60%),
  radial-gradient(900px 600px at -10% 30%, rgba(126,232,199,.10), transparent 60%),
  radial-gradient(800px 700px at 60% 110%, rgba(251,113,133,.08), transparent 60%), var(--bg)}
.cosmos::before{content:'';position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.028) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.028) 1px, transparent 1px);
  background-size:56px 56px;mask-image:radial-gradient(1200px 800px at 50% 0%, #000 30%, transparent 75%)}
.blob{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5;animation:drift 26s ease-in-out infinite alternate}
.blob.b1{width:560px;height:560px;background:#2b1d63;top:-180px;right:-120px}
.blob.b2{width:480px;height:480px;background:#0b3b2e;bottom:-160px;left:-140px;animation-delay:-9s}
.blob.b3{width:380px;height:380px;background:#3d1230;top:44%;left:58%;animation-delay:-17s}
@keyframes drift{from{transform:translate(0,0) scale(1)}to{transform:translate(-70px,60px) scale(1.15)}}
.mote{position:fixed;z-index:-1;font-family:var(--disp);color:rgba(233,237,248,.07);user-select:none;pointer-events:none;animation:floaty linear infinite}
@keyframes floaty{from{transform:translateY(12vh) rotate(-4deg)}to{transform:translateY(-118vh) rotate(5deg)}}
@media (prefers-reduced-motion: reduce){.blob,.mote{animation:none}.mote{display:none}}

/* ── nav ── */
nav{position:fixed;top:14px;left:50%;transform:translateX(-50%);z-index:50;width:min(1180px,calc(100% - 28px));
  display:flex;align-items:center;gap:26px;padding:12px 22px;border-radius:18px;
  background:rgba(10,14,26,.62);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);border:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;font-family:var(--disp);font-weight:600;font-size:1.28rem;letter-spacing:.2px}
.brand .sig{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;font-size:1.15rem;color:#04281d;
  background:linear-gradient(135deg,var(--mint),#4ad3a6);box-shadow:0 4px 18px rgba(126,232,199,.35)}
.navlinks{display:flex;gap:20px;margin-left:auto;font-size:.94rem;color:#aab3ca}
.navlinks a{transition:color .15s;white-space:nowrap}
.navlinks a:hover{color:var(--ink)}
.nav-right{display:flex;align-items:center;gap:11px}
.nav-cart{position:relative;display:grid;place-items:center;width:40px;height:40px;border-radius:12px;border:1px solid var(--line);color:#aab3ca;transition:color .15s,border-color .15s}
.nav-cart:hover{color:var(--mint);border-color:var(--mint)}
.cart-n{position:absolute;top:-6px;right:-6px;min-width:18px;height:18px;border-radius:100px;background:var(--mint);color:#04281d;font-size:.68rem;font-weight:700;display:grid;place-items:center;padding:0 4px}
.nav-ghost{padding:9px 14px;border-radius:12px;border:1px solid var(--line);font-size:.9rem;color:var(--ink);white-space:nowrap;transition:border-color .15s}
.nav-ghost:hover{border-color:var(--mint)}
.nav-cta{padding:9px 18px;border-radius:12px;font-weight:600;font-size:.92rem;color:#04281d;white-space:nowrap;
  background:linear-gradient(135deg,var(--mint),#57d9ad);box-shadow:0 4px 20px rgba(126,232,199,.3);transition:transform .15s}
.nav-cta:hover{transform:translateY(-1px)}
.burger{display:none;width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:none;color:var(--ink);cursor:pointer;place-items:center}
@media(max-width:1180px){.navlinks{display:none}.nav-right{margin-left:auto}.burger{display:grid}}
@media(max-width:560px){.nav-cta,.nav-ghost{display:none}}

/* ── mobile drawer ── */
.drawer{position:fixed;inset:0;z-index:60;display:none}
.drawer.open{display:block}
.drawer .scrim{position:absolute;inset:0;background:rgba(4,6,12,.65);backdrop-filter:blur(4px)}
.drawer .panel{position:absolute;top:0;right:0;bottom:0;width:min(320px,88vw);background:rgba(10,14,26,.97);
  border-left:1px solid var(--line);padding:20px;overflow-y:auto;display:flex;flex-direction:column;gap:2px}
.drawer .panel a{display:block;padding:13px 12px;border-radius:10px;color:var(--ink);font-size:1rem}
.drawer .panel a:hover{background:rgba(126,232,199,.08)}
.drawer .dlabel{margin:16px 12px 4px;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;color:var(--dim)}
.drawer .dclose{align-self:flex-end;width:44px;height:44px;border-radius:12px;border:1px solid var(--line);background:none;color:var(--ink);font-size:1.5rem;cursor:pointer;margin-bottom:8px}

/* ── hero ── */
.hero{min-height:100svh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;
  padding:130px 20px 70px;position:relative}
.overline{font-size:.8rem;letter-spacing:.34em;text-transform:uppercase;color:var(--mint);opacity:.9;margin-bottom:26px;
  display:flex;align-items:center;gap:14px}
.overline::before,.overline::after{content:'';width:44px;height:1px;background:linear-gradient(90deg,transparent,var(--mint));display:inline-block}
.overline::after{background:linear-gradient(90deg,var(--mint),transparent)}
h1{font-family:var(--disp);font-weight:420;font-size:clamp(2.9rem,8.2vw,6.4rem);line-height:1.02;letter-spacing:-.015em;max-width:1100px}
h1 .it{font-style:italic;font-weight:520;background:linear-gradient(100deg,var(--mint) 10%,var(--amber) 55%,var(--violet) 95%);
  -webkit-background-clip:text;background-clip:text;color:transparent}
.hero-sub{margin-top:26px;max-width:640px;color:var(--dim);font-size:clamp(1rem,1.6vw,1.18rem)}
.hero-sub b{color:var(--ink);font-weight:600}
.hero-cta{display:flex;gap:16px;margin-top:40px;flex-wrap:wrap;justify-content:center}
.btn-solar{padding:16px 34px;border-radius:16px;font-weight:700;font-size:1.03rem;color:#04281d;position:relative;
  background:linear-gradient(135deg,var(--mint),#4ad3a6);box-shadow:0 10px 34px rgba(126,232,199,.35);transition:transform .18s,box-shadow .18s}
.btn-solar:hover{transform:translateY(-2px);box-shadow:0 16px 44px rgba(126,232,199,.45)}
.btn-ghost2{padding:16px 34px;border-radius:16px;font-weight:600;font-size:1.03rem;color:var(--ink);
  border:1px solid var(--line);background:var(--glass);backdrop-filter:blur(8px);transition:border-color .18s,transform .18s}
.btn-ghost2:hover{border-color:rgba(126,232,199,.5);transform:translateY(-2px)}
.hero-stats{display:flex;gap:clamp(24px,6vw,74px);margin-top:64px;flex-wrap:wrap;justify-content:center}
.stat b{display:block;font-family:var(--disp);font-size:clamp(1.9rem,3.4vw,2.7rem);font-weight:560;color:var(--ink)}
.stat span{font-size:.86rem;color:var(--dim);letter-spacing:.14em;text-transform:uppercase}
.scrollcue{position:absolute;bottom:26px;left:50%;transform:translateX(-50%);color:var(--dim);font-size:.78rem;letter-spacing:.3em;text-transform:uppercase;animation:bob 2.2s ease-in-out infinite}
@keyframes bob{0%,100%{transform:translate(-50%,0)}50%{transform:translate(-50%,8px)}}

/* ── marquee ── */
.marquee{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:rgba(255,255,255,.02);
  overflow:hidden;padding:18px 0;position:relative}
.marquee .track{display:flex;gap:56px;white-space:nowrap;animation:slide 36s linear infinite;width:max-content}
.marquee span{font-family:var(--disp);font-style:italic;font-size:1.25rem;color:var(--dim)}
.marquee span em{color:var(--mint);font-style:normal;margin-right:10px}
@keyframes slide{from{transform:translateX(0)}to{transform:translateX(-50%)}}

/* ── sections ── */
section{padding:110px 20px}
.wrap{max-width:1180px;margin:0 auto}
.sec-head{margin-bottom:56px}
.kicker{font-size:.8rem;letter-spacing:.3em;text-transform:uppercase;color:var(--amber)}
h2{font-family:var(--disp);font-weight:440;font-size:clamp(2rem,4.6vw,3.4rem);line-height:1.08;margin-top:14px;letter-spacing:-.01em}
h2 .it{font-style:italic;color:var(--mint)}
.sec-sub{color:var(--dim);max-width:560px;margin-top:16px}

/* ── keypad ── */
.keypad-zone{display:grid;grid-template-columns:1fr 1fr;gap:60px;align-items:center}
@media(max-width:900px){.keypad-zone{grid-template-columns:1fr}}
.keypad{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;perspective:900px}
.key{position:relative;border-radius:18px;border:1px solid var(--line);background:linear-gradient(180deg,rgba(255,255,255,.07),rgba(255,255,255,.02));
  padding:26px 8px 20px;text-align:center;cursor:pointer;transition:transform .16s,border-color .16s,box-shadow .16s;display:block}
.key b{font-family:var(--disp);font-size:1.9rem;font-weight:520;display:block;line-height:1}
.key span{font-size:.72rem;color:var(--dim);letter-spacing:.12em;text-transform:uppercase;display:block;margin-top:8px}
.key:hover{transform:translateY(-5px) rotateX(7deg);border-color:rgba(126,232,199,.55);box-shadow:0 18px 34px rgba(0,0,0,.5),0 0 26px rgba(126,232,199,.18)}
.key.exam{grid-column:span 2;background:linear-gradient(135deg,rgba(255,196,102,.14),rgba(255,255,255,.03))}
.key.exam:hover{border-color:rgba(255,196,102,.6);box-shadow:0 18px 34px rgba(0,0,0,.5),0 0 26px rgba(255,196,102,.2)}
.key.exam b{font-size:1.35rem;letter-spacing:.04em}
.key .cnt{position:absolute;top:10px;right:12px;font-size:.66rem;color:var(--mint);letter-spacing:.06em}

/* ── shelf ── */
.shelf{display:flex;gap:26px;overflow-x:auto;padding:20px 4px 34px;scroll-snap-type:x mandatory;scrollbar-width:thin;scrollbar-color:#2a3350 transparent}
.shelf::-webkit-scrollbar{height:8px}
.shelf::-webkit-scrollbar-thumb{background:#232b45;border-radius:8px}
.tome{flex:0 0 250px;scroll-snap-align:start;border-radius:20px;border:1px solid var(--line);
  background:linear-gradient(180deg,rgba(255,255,255,.055),rgba(255,255,255,.015));padding:16px;
  transition:transform .2s,border-color .2s,box-shadow .2s;transform-style:preserve-3d;display:block}
.tome:hover{transform:translateY(-8px);border-color:rgba(167,139,250,.5);box-shadow:0 26px 50px rgba(0,0,0,.55),0 0 30px rgba(167,139,250,.14)}
.tome .cover{border-radius:12px;overflow:hidden;aspect-ratio:3/4;background:#141a2e;position:relative}
.tome .cover img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .35s}
.tome:hover .cover img{transform:scale(1.045)}
.tome .flame{position:absolute;top:10px;left:10px;background:linear-gradient(135deg,var(--rose),#f43f5e);color:#fff;
  font-size:.7rem;font-weight:700;padding:4px 10px;border-radius:20px;letter-spacing:.05em}
.tome h3{font-size:.95rem;font-weight:600;line-height:1.4;margin:14px 2px 8px;min-height:2.8em;color:var(--ink)}
.tome .rate{display:flex;align-items:baseline;gap:10px;margin:0 2px}
.tome .rate b{font-family:var(--disp);font-size:1.5rem;color:var(--mint)}
.tome .rate s{color:var(--dim);font-size:.9rem}
.tome .grab{margin-top:12px;display:block;text-align:center;padding:11px 0;border-radius:12px;font-weight:700;font-size:.9rem;
  color:#04281d;background:linear-gradient(135deg,var(--mint),#4ad3a6);opacity:0;transform:translateY(4px);transition:opacity .2s,transform .2s}
.tome:hover .grab{opacity:1;transform:translateY(0)}
@media (hover:none){.tome .grab{opacity:1;transform:none}}
@media (max-width:640px){.hero-stats{display:grid;grid-template-columns:1fr 1fr;gap:26px}}

/* ── bento ── */
.bento{display:grid;grid-template-columns:repeat(6,1fr);gap:20px}
.cell{border-radius:22px;border:1px solid var(--line);background:var(--glass);padding:34px;position:relative;overflow:hidden;
  transition:border-color .2s,transform .2s}
.cell:hover{border-color:rgba(126,232,199,.4);transform:translateY(-4px)}
.cell.big{grid-column:span 4;grid-row:span 2}
.cell.tall{grid-column:span 2;grid-row:span 2}
.cell.wide{grid-column:span 3}
.cell.sq{grid-column:span 3}
@media(max-width:900px){.cell.big,.cell.tall,.cell.wide,.cell.sq{grid-column:span 6}}
.cell .ic{font-size:1.9rem;margin-bottom:14px;display:inline-block}
.cell h3{font-family:var(--disp);font-weight:520;font-size:1.45rem;margin-bottom:10px}
.cell p{color:var(--dim);font-size:.98rem}
.chalk{font-family:var(--disp);font-style:italic;color:var(--mint);background:rgba(126,232,199,.07);
  border:1px dashed rgba(126,232,199,.35);border-radius:14px;padding:18px 22px;margin-top:22px;font-size:1.12rem;line-height:1.9}
.bignum{position:absolute;right:18px;bottom:0;font-family:var(--disp);font-size:7rem;font-weight:600;color:rgba(255,255,255,.05);line-height:1}

/* ── steps ── */
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:26px}
@media(max-width:820px){.steps{grid-template-columns:1fr}}
.step{position:relative;padding:38px 30px 34px;border-radius:22px;border:1px solid var(--line);background:var(--glass)}
.step .n{font-family:var(--disp);font-size:4.6rem;font-weight:560;line-height:1;
  color:transparent;-webkit-text-stroke:1.4px rgba(255,196,102,.75)}
.step h3{font-size:1.2rem;font-weight:700;margin:18px 0 10px}
.step p{color:var(--dim);font-size:.96rem}

/* ── final ── */
.finale{text-align:center;padding:150px 20px 130px;position:relative}
.finale h2{font-size:clamp(2.4rem,6vw,4.6rem)}
.finale .btn-solar{margin-top:44px;display:inline-block}
footer{border-top:1px solid var(--line);padding:34px 20px;color:var(--dim);font-size:.88rem}
footer .wrap{display:flex;gap:22px;flex-wrap:wrap;justify-content:space-between;align-items:center}
footer a:hover{color:var(--ink)}

/* ── vidaara free strip ── */
.vid-strip{display:flex;align-items:center;justify-content:space-between;gap:26px;flex-wrap:wrap;
  padding:34px 38px;border-radius:24px;border:1px solid rgba(74,222,128,.28);
  background:linear-gradient(120deg,rgba(74,222,128,.08),rgba(96,165,250,.06) 60%,transparent);
  transition:transform .35s ease,border-color .35s ease,box-shadow .35s ease}
.vid-strip:hover{transform:translateY(-4px);border-color:rgba(74,222,128,.55);box-shadow:0 24px 60px -30px rgba(74,222,128,.35)}
.vid-strip h3{font-family:'Fraunces',serif;font-size:clamp(1.3rem,2.6vw,1.8rem);margin-bottom:8px}
.vid-strip h3 em{font-style:italic;color:var(--mint)}
.vid-strip p{color:var(--dim);max-width:560px;font-size:.95rem;line-height:1.65}
.vid-strip .free-tag{display:inline-block;font-size:.68rem;letter-spacing:.16em;text-transform:uppercase;
  color:var(--mint);border:1px solid rgba(74,222,128,.4);border-radius:100px;padding:5px 12px;margin-bottom:14px}
.vid-go{white-space:nowrap;font-weight:700;color:var(--mint);font-size:1.05rem;border:1px solid rgba(74,222,128,.4);
  border-radius:14px;padding:15px 26px;transition:background .3s ease}
.vid-strip:hover .vid-go{background:rgba(74,222,128,.12)}

/* reveal */
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s ease,transform .7s ease}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion: reduce){.rv{opacity:1;transform:none;transition:none}}
</style>
</head>
<body>

<div class="cosmos"><div class="blob b1"></div><div class="blob b2"></div><div class="blob b3"></div></div>

