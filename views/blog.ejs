<% locals.layout = 'layout' %>

<section style="background:linear-gradient(135deg,#1e3a8a 0%,#2563eb 100%);padding:60px 0 40px;color:#fff">
  <div class="container">
    <div class="section-tag" style="background:rgba(255,255,255,0.15);color:#fff;display:inline-block;margin-bottom:16px">Free Resources</div>
    <h1 style="font-size:2.2rem;font-weight:800;margin-bottom:12px;color:#fff">MathStudy Blog</h1>
    <p style="color:rgba(255,255,255,0.85);font-size:1.05rem;max-width:600px">Study guides, CBSE tips, JEE prep strategies and free worksheet downloads — written by our educators.</p>
  </div>
</section>

<section class="section">
  <div class="container">

    <!-- Category filter -->
    <% if (categories.length > 0) { %>
    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-bottom:36px">
      <a href="/blog" style="padding:6px 16px;border-radius:99px;font-size:0.82rem;font-weight:600;text-decoration:none;background:<%= !activeCat?'#2563eb':'#f1f5f9' %>;color:<%= !activeCat?'#fff':'#475569' %>">All Posts</a>
      <% categories.forEach(function(cat){ %>
      <a href="/blog?cat=<%= encodeURIComponent(cat) %>"
         style="padding:6px 16px;border-radius:99px;font-size:0.82rem;font-weight:600;text-decoration:none;background:<%= activeCat===cat?'#2563eb':'#f1f5f9' %>;color:<%= activeCat===cat?'#fff':'#475569' %>">
        <%= cat %>
      </a>
      <% }); %>
    </div>
    <% } %>

    <!-- Posts grid -->
    <% if (posts.length === 0) { %>
    <div style="text-align:center;padding:80px 0;color:#94a3b8">
      <div style="font-size:3rem;margin-bottom:16px">📝</div>
      <h2 style="color:#cbd5e1;margin-bottom:8px">No posts yet</h2>
      <p>Check back soon — we publish new guides every week.</p>
    </div>
    <% } else { %>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px">
      <% posts.forEach(function(post){ %>
      <article style="background:#fff;border:1px solid var(--border);border-radius:16px;overflow:hidden;display:flex;flex-direction:column;transition:transform .15s,box-shadow .15s"
               onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 12px 32px rgba(0,0,0,0.10)'"
               onmouseout="this.style.transform='';this.style.boxShadow=''">

        <% if (post.cover_image) { %>
        <a href="/blog/<%= post.slug %>"><img src="<%= post.cover_image %>" alt="<%= post.title %>" loading="lazy" style="width:100%;height:190px;object-fit:cover"></a>
        <% } else { %>
        <a href="/blog/<%= post.slug %>" style="display:flex;align-items:center;justify-content:center;height:130px;background:linear-gradient(135deg,#dbeafe,#eff6ff);font-size:3rem;text-decoration:none">📚</a>
        <% } %>

        <div style="padding:20px 22px;flex:1;display:flex;flex-direction:column">
          <% if (post.category) { %>
          <span style="background:#dbeafe;color:#1d4ed8;padding:2px 10px;border-radius:99px;font-size:0.75rem;font-weight:600;display:inline-block;margin-bottom:10px;width:fit-content"><%= post.category %></span>
          <% } %>
          <h2 style="font-size:1.05rem;font-weight:700;line-height:1.4;margin-bottom:10px">
            <a href="/blog/<%= post.slug %>" style="color:inherit;text-decoration:none"><%= post.title %></a>
          </h2>
          <p style="color:#64748b;font-size:0.875rem;line-height:1.6;flex:1;margin-bottom:14px"><%= post.meta_desc || post.excerpt || '' %></p>
          <div style="display:flex;align-items:center;justify-content:space-between;font-size:0.78rem;color:#94a3b8;margin-top:auto">
            <span><%= new Date(post.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'short',year:'numeric'}) %></span>
            <a href="/blog/<%= post.slug %>" style="color:#2563eb;font-weight:600;text-decoration:none">Read &rarr;</a>
          </div>
        </div>
      </article>
      <% }); %>
    </div>
    <% } %>

  </div>
</section>

<section style="background:#1e3a8a;padding:48px 0;text-align:center">
  <div class="container">
    <h2 style="color:#fff;margin-bottom:12px">Looking for Practice Material?</h2>
    <p style="color:rgba(255,255,255,0.8);margin-bottom:24px">Browse our premium math e-books — CBSE, ICSE, JEE and more.</p>
    <a href="/shop" class="btn btn-accent btn-lg">Browse E-Books &rarr;</a>
  </div>
</section>
