<% locals.layout = 'layout' %>
<div class="dash-wrap">
  <div class="dash-header">
    <h1 class="dash-name">Hi, <%= user.name %></h1>
    <p class="text-muted">Your purchased e-books are available to download below.</p>
    <p style="margin-top:6px">
      <a href="/account/password" style="color:var(--secondary);font-weight:600;text-decoration:none;font-size:.9rem">🔒 Change password</a>
      &nbsp;·&nbsp; <a href="/dashboard/support" style="color:var(--secondary);font-weight:600;text-decoration:none;font-size:.9rem">🎫 My support tickets</a>
      <% if (user.role === 'admin' || user.role === 'super_admin') { %>
        &nbsp;·&nbsp; <a href="/admin" style="color:var(--secondary);font-weight:600;text-decoration:none;font-size:.9rem">⚙️ Admin panel</a>
      <% } %>
    </p>
  </div>

  <% if (locals.paymentReminder) { %>
    <div style="display:flex;align-items:center;justify-content:space-between;gap:14px;flex-wrap:wrap;background:#fffbeb;border:1.5px solid #f59e0b;border-radius:12px;padding:14px 18px;margin-bottom:20px">
      <div>
        <div style="font-weight:700;color:#78350f">💳 We received a payment from you</div>
        <div style="font-size:0.88rem;color:#78350f">It isn't linked to an order yet — confirm the UTR and e-book(s) you bought to get your download link.</div>
      </div>
      <a href="/support/ticket/<%= paymentReminder.access_token %>" class="btn btn-primary" style="white-space:nowrap">Confirm your payment</a>
    </div>
  <% } %>

  <% if (!orders || !orders.length) { %>
    <div style="text-align:center;padding:60px 0;background:#fff;border:1px solid var(--border);border-radius:16px">
      <div style="font-size:3rem;margin-bottom:12px">📚</div>
      <h3>No purchases yet</h3>
      <p style="margin:8px 0 20px">Browse our e-book shop and get your first book.</p>
      <a href="/shop" class="btn btn-primary">Browse E-Books</a>
    </div>
  <% } else { %>
    <% orders.forEach(function(order){ %>
    <div class="order-card">
      <div class="order-head">
        <div>
          <div style="font-size:0.75rem;color:var(--muted);margin-bottom:2px">Order #<%= order.id %> &bull; <%= new Date(order.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %></div>
          <div style="font-weight:700">&#8377;<%= parseFloat(order.total_amount).toFixed(0) %></div>
        </div>
        <span class="order-status status-<%= order.status %>"><%= order.status %></span>
      </div>
      <% if (order.titles) {
         var titles   = order.titles.split('||');
         var tokens   = (order.tokens||'').split('||');
         var covers   = (order.covers||'').split('||');
         var canDl    = (order.can_download||'').split('||');
      %>
      <div class="order-items">
        <% for (var i=0;i<titles.length;i++) { %>
        <div class="order-item">
          <div class="order-item-thumb">
            <% if (covers[i] && covers[i]!=='null') { %>
              <img src="<%= covers[i] %>" alt="<%= titles[i] %>">
            <% } else { %>
              <div style="background:#f3f4f6;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem">📚</div>
            <% } %>
          </div>
          <div class="order-item-info">
            <div class="order-item-title"><%= titles[i] %></div>
            <% if (order.status==='paid' && tokens[i] && tokens[i]!=='null') { %>
              <% if (canDl[i]==='1') { %>
                <a href="/download/<%= tokens[i] %>" class="btn-download">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                  Download PDF
                </a>
              <% } else { %>
                <span class="btn-expired">Link expired — contact support</span>
              <% } %>
            <% } %>
          </div>
        </div>
        <% } %>
      </div>
      <% } %>
    </div>
    <% }); %>
  <% } %>
</div>
