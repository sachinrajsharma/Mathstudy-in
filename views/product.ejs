<% locals.layout = 'layout' %>
<%
const base = locals.baseUrl || 'https://mathstudy.in';
const discount = product.original_price && product.original_price > product.price
  ? Math.round((1 - product.price/product.original_price)*100) : 0;
%>
<%# Product + FAQPage structured data is injected from lib/seo.js via the layout %>

<div class="container" style="padding-top:32px;padding-bottom:60px">
  <!-- Breadcrumb -->
  <nav class="breadcrumb" aria-label="breadcrumb">
    <a href="/">Home</a><span>/</span>
    <a href="/shop">Shop</a><span>/</span>
    <% if (product.cat_name) { %>
      <a href="/shop/category/<%= product.cat_slug %>"><%= product.cat_name %></a><span>/</span>
    <% } %>
    <span><%= product.title %></span>
  </nav>

  <div class="product-detail">
    <!-- Cover -->
    <div class="product-cover-wrap">
      <div class="product-cover">
        <% if (product.cover_image) { %>
          <img src="<%= product.cover_image %>" alt="<%= product.title %>" >
        <% } else { %>
          <div style="display:flex;align-items:center;justify-content:center;height:400px;background:#f3f4f6;font-size:5rem">📚</div>
        <% } %>
      </div>
      <div style="margin-top:16px;padding:16px;background:#f0f9ff;border:1px solid #bae6fd;border-radius:10px">
        <p style="font-size:0.82rem;color:#0369a1;font-weight:600;margin-bottom:6px">Secure Instant Download</p>
        <p style="font-size:0.78rem;color:#0284c7">After payment, download your PDF immediately. Re-download up to 5 times within 48 hours, and always from your dashboard.</p>
      </div>
    </div>

    <!-- Info -->
    <div class="product-info">
      <div class="product-meta">
        <% if (product.cat_name) { %><span class="product-badge"><%= product.cat_name %></span><% } %>
        <% if (product.grade) { %><span class="product-badge" style="background:#dcfce7;color:#166534"><%= product.grade %></span><% } %>
        <% if (product.board) { %><span class="product-badge" style="background:#fef9c3;color:#854d0e"><%= product.board %></span><% } %>
      </div>
      <h1><%= product.title %></h1>

      <div class="product-price">
        <span class="price-current">&#8377;<%= parseFloat(product.price).toFixed(0) %></span>
        <% if (discount) { %>
          <span class="price-original">&#8377;<%= parseFloat(product.original_price).toFixed(0) %></span>
          <span class="price-discount"><%= discount %>% OFF</span>
        <% } %>
      </div>

      <% if (locals.reviewCount && reviewCount > 0) { %>
      <a href="#reviews" style="display:inline-flex;align-items:center;gap:7px;text-decoration:none;font-weight:600;font-size:.9rem;margin-bottom:14px">
        <span style="color:#f59e0b;letter-spacing:1px"><% for (var s=1;s<=5;s++){ %><%= s <= Math.round(reviewAvg) ? '★' : '☆' %><% } %></span>
        <span style="color:var(--muted);font-weight:500"><%= reviewAvg.toFixed(1) %> · <%= reviewCount %> review<%= reviewCount===1?'':'s' %></span>
      </a>
      <% } %>

      <% if (locals.bundleItems && bundleItems.length) { %>
      <div style="border:1px solid var(--secondary);background:#f0fdfa;border-radius:10px;padding:14px 18px;margin-bottom:20px">
        <div style="font-weight:700;color:var(--dark);margin-bottom:8px">📦 This bundle includes <%= bundleItems.length %> e-books</div>
        <ul style="margin:0;padding-left:18px;font-size:.9rem;color:var(--mid);line-height:1.8">
          <% bundleItems.forEach(function(b){ %><li><a href="/shop/product/<%= b.slug %>" style="color:var(--mid)"><%= b.title %></a></li><% }); %>
        </ul>
        <div style="font-size:.82rem;color:var(--secondary);font-weight:600;margin-top:8px">Buy together and save — all e-books delivered after one payment.</div>
      </div>
      <% } %>

      <% if (product.short_desc) { %>
        <p class="product-desc"><%= product.short_desc %></p>
      <% } %>
      <% if (product.description) { %>
        <div style="font-size:0.93rem;color:var(--mid);line-height:1.8;margin-bottom:24px"><%- product.description %></div>
      <% } %>

      <!-- CTA -->
      <div class="product-cta">
        <% if (alreadyOwned) { %>
          <div class="alert alert-success" style="margin:0">
            You already own this book. <a href="/dashboard">Go to My Orders</a> to download.
          </div>
        <% } else { %>
          <button class="btn btn-primary btn-lg" onclick="addToCart('<%= product.id %>', this)">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            Add to Cart — &#8377;<%= parseFloat(product.price).toFixed(0) %>
          </button>
          <a href="/cart" class="btn btn-outline btn-lg">Buy Now</a>
        <% } %>
      </div>

      <!-- Features -->
      <div class="product-features">
        <div class="feature-item"><span class="feature-icon">✓</span> Instant PDF download</div>
        <div class="feature-item"><span class="feature-icon">✓</span> High-quality content</div>
        <div class="feature-item"><span class="feature-icon">✓</span> CBSE/ICSE aligned</div>
        <% if (product.page_count) { %><div class="feature-item"><span class="feature-icon">✓</span> <%= product.page_count %> pages</div><% } %>
        <div class="feature-item"><span class="feature-icon">✓</span> Re-download up to 5x</div>
        <div class="feature-item"><span class="feature-icon">✓</span> Works on all devices</div>
      </div>
    </div>
  </div>

  <!-- FAQ (matches the FAQPage structured data) -->
  <% if (locals.faqs && faqs.length) { %>
  <section class="product-faq" style="margin-top:48px;max-width:780px">
    <h2 style="font-size:1.35rem;font-weight:800;color:var(--dark);margin-bottom:18px">Frequently asked questions</h2>
    <% faqs.forEach(function(f){ %>
    <div class="faq-item" style="border:1px solid var(--border);border-radius:10px;margin-bottom:10px;overflow:hidden">
      <button type="button" class="faq-q" style="width:100%;text-align:left;background:#fff;border:none;padding:14px 18px;font-size:0.95rem;font-weight:600;color:var(--dark);cursor:pointer;display:flex;justify-content:space-between;align-items:center;gap:12px">
        <span><%= f.q %></span><span class="faq-ico" style="color:var(--secondary);font-size:1.2rem;flex-shrink:0">+</span>
      </button>
      <div class="faq-a" style="display:none;padding:0 18px 16px;font-size:0.9rem;color:var(--mid);line-height:1.7"><%= f.a %></div>
    </div>
    <% }); %>
  </section>
  <script>
  (function(){
    document.querySelectorAll('.product-faq .faq-q').forEach(function(b){
      b.addEventListener('click', function(){
        var a = b.parentNode.querySelector('.faq-a');
        var open = a.style.display === 'block';
        a.style.display = open ? 'none' : 'block';
        b.querySelector('.faq-ico').textContent = open ? '+' : '–';
      });
    });
  })();
  </script>
  <% } %>

  <!-- Reviews -->
  <section id="reviews" style="margin-top:48px;max-width:780px">
    <h2 style="font-size:1.35rem;font-weight:800;color:var(--dark);margin-bottom:6px">Reviews <% if (reviewCount) { %><span style="color:#f59e0b">★ <%= reviewAvg.toFixed(1) %></span> <span style="color:var(--muted);font-size:.9rem;font-weight:500">(<%= reviewCount %>)</span><% } %></h2>
    <% if (!reviewCount) { %>
      <p style="color:var(--muted);margin-bottom:18px">No reviews yet — be the first to review this e-book.</p>
    <% } else { %>
      <div style="margin:14px 0 26px">
        <% reviews.forEach(function(r){ %>
        <div style="border-top:1px solid var(--border);padding:14px 0">
          <div style="display:flex;justify-content:space-between;align-items:center;gap:10px">
            <strong style="color:var(--dark)"><%= r.author_name %></strong>
            <span style="color:#f59e0b;letter-spacing:1px"><% for (var s=1;s<=5;s++){ %><%= s<=r.rating?'★':'☆' %><% } %></span>
          </div>
          <% if (r.title) { %><div style="font-weight:600;margin-top:6px"><%= r.title %></div><% } %>
          <% if (r.body) { %><div style="color:var(--mid);font-size:.92rem;margin-top:4px;line-height:1.6"><%= r.body %></div><% } %>
        </div>
        <% }); %>
      </div>
    <% } %>

    <div style="border:1px solid var(--border);border-radius:12px;padding:18px;background:#fafafa">
      <h3 style="font-size:1.05rem;font-weight:700;margin:0 0 12px">Write a review</h3>
      <form method="POST" action="/shop/product/<%= product.id %>/review">
        <div style="margin-bottom:12px">
          <label style="font-size:.85rem;font-weight:600;display:block;margin-bottom:6px">Your rating</label>
          <span class="star-pick" style="font-size:1.7rem;cursor:pointer;letter-spacing:3px"><% for (var s=1;s<=5;s++){ %><span data-v="<%= s %>" style="color:#d1d5db">☆</span><% } %></span>
          <input type="hidden" name="rating" id="ratingInput" value="5">
        </div>
        <% if (!(locals.user && user)) { %>
        <input type="text" name="author_name" placeholder="Your name" required style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:10px;font-size:.92rem">
        <% } %>
        <input type="text" name="title" placeholder="Headline (optional)" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:10px;font-size:.92rem">
        <textarea name="body" rows="3" placeholder="What did you think? Was it helpful?" style="width:100%;padding:9px 12px;border:1px solid var(--border);border-radius:8px;margin-bottom:12px;font-size:.92rem;resize:vertical"></textarea>
        <button type="submit" class="btn btn-primary">Submit review</button>
      </form>
    </div>
  </section>
  <script>
  (function(){
    var pick = document.querySelector('.star-pick'); if (!pick) return;
    var input = document.getElementById('ratingInput'); var stars = pick.querySelectorAll('span');
    function paint(v){ stars.forEach(function(s){ var on = +s.dataset.v <= v; s.textContent = on ? '★' : '☆'; s.style.color = on ? '#f59e0b' : '#d1d5db'; }); }
    stars.forEach(function(s){
      s.addEventListener('click', function(){ input.value = s.dataset.v; paint(+s.dataset.v); });
      s.addEventListener('mouseover', function(){ paint(+s.dataset.v); });
    });
    pick.addEventListener('mouseleave', function(){ paint(+input.value); });
    paint(5);
  })();
  </script>

  <!-- Related products -->
  <% if (related && related.length) { %>
  <div style="margin-top:60px">
    <h2 style="margin-bottom:24px">You Might Also Like</h2>
    <div class="products-grid">
      <% related.forEach(function(p){ %>
      <div class="product-card">
        <a href="/shop/product/<%= p.slug %>" class="product-card-img">
          <% if (p.cover_image) { %><img src="<%= p.cover_image %>" alt="<%= p.title %>" loading="lazy"><% } else { %><div class="no-cover">📚</div><% } %>
        </a>
        <div class="product-card-body">
          <a href="/shop/product/<%= p.slug %>"><div class="product-card-title"><%= p.title %></div></a>
          <div class="product-card-price">
            <span class="price-current">&#8377;<%= parseFloat(p.price).toFixed(0) %></span>
            <% if (p.original_price && p.original_price > p.price) { %><span class="price-original">&#8377;<%= parseFloat(p.original_price).toFixed(0) %></span><% } %>
          </div>
          <button class="btn btn-primary btn-sm" onclick="addToCart('<%= p.id %>', this)">Add to Cart</button>
        </div>
      </div>
      <% }); %>
    </div>
  </div>
  <% } %>
</div>
