<% locals.layout = 'layout' %>
<div class="admin-wrap">
  <%- include('../partials/admin-sidebar', { active: 'orders' }) %>
  <div class="admin-main">
    <div class="admin-title">Orders</div>
    <div class="admin-sub">
      <%= orders.length %> total &bull;
      <span id="pendingCount" style="color:#b45309;font-weight:700">
        <%= orders.filter(function(o){return o.status==='pending';}).length %>
      </span> pending approval
    </div>

    <!-- Filter tabs -->
    <div style="display:flex;gap:8px;margin-bottom:18px;flex-wrap:wrap">
      <button class="filter-btn active" onclick="filterOrders('all', this)">All</button>
      <button class="filter-btn" onclick="filterOrders('pending', this)" style="border-color:#b45309;color:#b45309">Pending</button>
      <button class="filter-btn" onclick="filterOrders('paid', this)" style="border-color:#065f46;color:#065f46">Paid</button>
      <button class="filter-btn" onclick="filterOrders('failed', this)" style="border-color:#991b1b;color:#991b1b">Failed</button>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table" id="ordersTable">
        <thead>
          <tr>
            <th>ID</th>
            <th>Order Ref</th>
            <th>Buyer</th>
            <th>Email</th>
            <th>Items</th>
            <th>Amount</th>
            <th>Status</th>
            <th>Date</th>
            <th style="min-width:130px">Action</th>
          </tr>
        </thead>
        <tbody>
          <% orders.forEach(function(o){ %>
          <tr data-status="<%= o.status %>">
            <td>#<%= o.id %></td>
            <td style="font-family:monospace;font-size:0.78rem;color:#1e3a8a;font-weight:700">
              <%= o.payment_id || '—' %>
            </td>
            <td><%= o.buyer %></td>
            <td style="font-size:0.78rem;color:var(--muted)"><%= o.email %></td>
            <td style="font-size:0.8rem;max-width:180px;word-break:break-word">
              <%= o.item_titles ? o.item_titles.split('||').join(', ') : '—' %>
            </td>
            <td style="font-weight:700">&#8377;<%= parseFloat(o.total_amount).toFixed(0) %></td>
            <td>
              <span class="order-status status-<%= o.status %>" id="statusBadge-<%= o.id %>">
                <%= o.status %>
              </span>
            </td>
            <td style="font-size:0.78rem"><%= new Date(o.created_at).toLocaleDateString('en-IN', {day:'2-digit',month:'short',year:'numeric'}) %></td>
            <td>
              <% if (o.status === 'pending') { %>
              <button
                class="btn-approve"
                id="approveBtn-<%= o.id %>"
                onclick="approveOrder(<%= o.id %>, this)">
                &#10003; Mark Paid
              </button>
              <button
                class="btn-reject"
                id="rejectBtn-<%= o.id %>"
                onclick="rejectOrder(<%= o.id %>, this)"
                style="margin-top:4px">
                &#10005; Reject
              </button>
              <% } else if (o.status === 'paid') { %>
              <span style="color:#065f46;font-size:0.78rem;font-weight:600">&#10003; Approved</span>
              <% } else if (o.status === 'failed' || o.status === 'refunded') { %>
              <span style="color:#991b1b;font-size:0.78rem;font-weight:600">&#10005; <%= o.status %></span>
              <% } else { %>
              <span style="color:#94a3b8;font-size:0.78rem">—</span>
              <% } %>
            </td>
          </tr>
          <% }); %>
          <% if (!orders.length) { %>
          <tr><td colspan="9" style="text-align:center;color:var(--muted);padding:40px">No orders yet</td></tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>
</div>

<style>
.filter-btn {
  padding: 6px 16px;
  border: 1.5px solid #cbd5e1;
  border-radius: 20px;
  background: #fff;
  color: #475569;
  font-size: 0.8rem;
  font-weight: 600;
  cursor: pointer;
  transition: all 0.15s;
}
.filter-btn.active, .filter-btn:hover {
  background: #1e3a8a;
  border-color: #1e3a8a;
  color: #fff;
}
.btn-approve {
  display: block;
  width: 100%;
  padding: 6px 10px;
  background: #065f46;
  color: #fff;
  border: none;
  border-radius: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition: background 0.15s;
}
.btn-approve:hover { background: #047857; }
.btn-approve:disabled { background: #94a3b8; cursor: default; }
.btn-reject {
  display: block;
  width: 100%;
  padding: 6px 10px;
  background: #fff;
  color: #991b1b;
  border: 1.5px solid #fca5a5;
  border-radius: 6px;
  font-size: 0.78rem;
  font-weight: 700;
  cursor: pointer;
  transition: all 0.15s;
}
.btn-reject:hover { background: #fef2f2; }
.btn-reject:disabled { opacity: 0.5; cursor: default; }
.status-pending  { background:#fef3c7; color:#b45309; border:1px solid #fde68a; padding:3px 9px; border-radius:20px; font-size:0.75rem; font-weight:700; display:inline-block; }
.status-paid     { background:#d1fae5; color:#065f46; border:1px solid #6ee7b7; padding:3px 9px; border-radius:20px; font-size:0.75rem; font-weight:700; display:inline-block; }
.status-failed   { background:#fee2e2; color:#991b1b; border:1px solid #fca5a5; padding:3px 9px; border-radius:20px; font-size:0.75rem; font-weight:700; display:inline-block; }
.status-refunded { background:#f3f4f6; color:#6b7280; border:1px solid #d1d5db; padding:3px 9px; border-radius:20px; font-size:0.75rem; font-weight:700; display:inline-block; }
</style>

<script>
function filterOrders(status, btn) {
  document.querySelectorAll('.filter-btn').forEach(function(b){ b.classList.remove('active'); });
  btn.classList.add('active');
  document.querySelectorAll('#ordersTable tbody tr[data-status]').forEach(function(row) {
    row.style.display = (status === 'all' || row.dataset.status === status) ? '' : 'none';
  });
}

function approveOrder(orderId, btn) {
  if (!confirm('Mark order #' + orderId + ' as PAID? This will generate download links for the buyer.')) return;
  btn.disabled = true;
  btn.textContent = 'Approving...';
  var rejectBtn = document.getElementById('rejectBtn-' + orderId);
  if (rejectBtn) rejectBtn.disabled = true;

  fetch('/admin/orders/' + orderId + '/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'action=approve'
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.ok) {
      var badge = document.getElementById('statusBadge-' + orderId);
      if (badge) {
        badge.textContent = 'paid';
        badge.className = 'order-status status-paid';
      }
      var row = btn.closest('tr');
      if (row) row.dataset.status = 'paid';
      var cell = btn.parentNode;
      if (cell) cell.innerHTML = '<span style="color:#065f46;font-size:0.78rem;font-weight:600">&#10003; Approved</span>';
      // Update pending count
      var countEl = document.getElementById('pendingCount');
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
      showAdminToast('Order #' + orderId + ' approved. ' + data.tokens + ' download link(s) generated.', 'success');
    } else {
      btn.disabled = false;
      btn.textContent = '&#10003; Mark Paid';
      if (rejectBtn) rejectBtn.disabled = false;
      showAdminToast(data.error || 'Failed to approve order.', 'error');
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = '&#10003; Mark Paid';
    if (rejectBtn) rejectBtn.disabled = false;
    showAdminToast('Network error. Try again.', 'error');
  });
}

function rejectOrder(orderId, btn) {
  if (!confirm('Mark order #' + orderId + ' as FAILED/rejected? The buyer will NOT get download access.')) return;
  btn.disabled = true;
  btn.textContent = 'Rejecting...';
  var approveBtn = document.getElementById('approveBtn-' + orderId);
  if (approveBtn) approveBtn.disabled = true;

  fetch('/admin/orders/' + orderId + '/approve', {
    method: 'POST',
    headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
    body: 'action=reject'
  })
  .then(function(r) { return r.json(); })
  .then(function(data) {
    if (data.ok) {
      var badge = document.getElementById('statusBadge-' + orderId);
      if (badge) {
        badge.textContent = 'failed';
        badge.className = 'order-status status-failed';
      }
      var row = btn.closest('tr');
      if (row) row.dataset.status = 'failed';
      var cell = btn.parentNode;
      if (cell) cell.innerHTML = '<span style="color:#991b1b;font-size:0.78rem;font-weight:600">&#10005; rejected</span>';
      var countEl = document.getElementById('pendingCount');
      if (countEl) countEl.textContent = Math.max(0, parseInt(countEl.textContent) - 1);
      showAdminToast('Order #' + orderId + ' marked as failed.', 'info');
    } else {
      btn.disabled = false;
      btn.textContent = '&#10005; Reject';
      if (approveBtn) approveBtn.disabled = false;
      showAdminToast(data.error || 'Failed to reject order.', 'error');
    }
  })
  .catch(function() {
    btn.disabled = false;
    btn.textContent = '&#10005; Reject';
    if (approveBtn) approveBtn.disabled = false;
    showAdminToast('Network error. Try again.', 'error');
  });
}

function showAdminToast(msg, type) {
  var existing = document.querySelector('.ms-toast');
  if (existing) existing.remove();
  var t = document.createElement('div');
  t.className = 'ms-toast';
  t.textContent = msg;
  var bg = type === 'success' ? '#065f46' : type === 'error' ? '#991b1b' : '#1e3a8a';
  t.style.cssText = 'position:fixed;bottom:24px;right:24px;z-index:9999;padding:12px 20px;border-radius:10px;font-size:0.88rem;font-weight:600;color:#fff;background:' + bg + ';box-shadow:0 8px 24px rgba(0,0,0,0.15);transition:opacity 0.3s;max-width:340px';
  document.body.appendChild(t);
  setTimeout(function() {
    t.style.opacity = '0';
    setTimeout(function() { if (t.parentNode) t.remove(); }, 300);
  }, 4000);
}
</script>
