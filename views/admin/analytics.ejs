<% locals.layout = 'layout' %>
<%
  // Shared formatters (en-IN grouping: 1,23,456)
  const fmt  = (n) => new Intl.NumberFormat('en-IN', { maximumFractionDigits: 0 }).format(Math.round(Number(n) || 0));
  const fmt2 = (n) => new Intl.NumberFormat('en-IN', { maximumFractionDigits: 2, minimumFractionDigits: 0 }).format(Number(n) || 0);
  const MONTHS_SHORT = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const ymLabel = (ym) => { const [y, m] = ym.split('-'); return MONTHS_SHORT[Number(m) - 1] + ' ' + y; };
  const dateLabel = (d) => d ? new Date(d).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) : '—';
  const last12 = months.slice(-12);
  const maxRev = Math.max(1, ...last12.map((r) => r.revenue));
  const maxUnits = Math.max(1, ...last12.map((r) => r.units));
  const top10 = books.slice(0, 10);
  const maxBookRev = Math.max(1, ...top10.map((r) => r.revenue));
%>
<style>
  /* Wide tables/charts scroll inside their card instead of stretching the page (320px-safe). */
  .admin-wrap > .admin-main { min-width:0 }
  .admin-main .admin-table-wrap { overflow-x:auto }
  .admin-main .admin-table { min-width:560px }
  .ana-grid2 { display:grid; grid-template-columns:1fr 1fr; gap:20px; margin-bottom:26px }
  @media(max-width:900px){ .ana-grid2 { grid-template-columns:1fr } }
  .ana-card { background:var(--white); border:1px solid var(--border); border-radius:14px; padding:20px }
  .ana-card h3 { margin:0 0 14px; font-size:1rem }
  .ana-chart { display:flex; align-items:flex-end; gap:6px; height:180px; padding-top:18px; overflow-x:auto }
  .ana-chart .ana-col { min-width:44px }
  .ana-col { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:flex-end; height:100%; min-width:0 }
  .ana-bar { width:100%; max-width:38px; border-radius:6px 6px 0 0; background:linear-gradient(180deg,#14b8a6,#0d9488); min-height:2px; position:relative }
  .ana-bar.alt { background:linear-gradient(180deg,#60a5fa,#2563eb) }
  .ana-val { font-size:.68rem; font-weight:700; color:var(--mid); margin-bottom:4px; white-space:nowrap }
  .ana-lab { font-size:.66rem; color:var(--muted); margin-top:6px; white-space:nowrap; transform:rotate(-38deg); transform-origin:top center; height:26px }
  .ana-hbar-row { display:grid; grid-template-columns:minmax(140px,2fr) 5fr auto; gap:10px; align-items:center; padding:6px 0; border-bottom:1px solid #f3f4f6; font-size:.84rem }
  .ana-hbar-row:last-child { border-bottom:none }
  .ana-hbar { height:14px; border-radius:7px; background:linear-gradient(90deg,#14b8a6,#0d9488); min-width:2px }
  .ana-hbar.cat { background:linear-gradient(90deg,#a78bfa,#7c3aed) }
  .ana-growth { display:inline-block; font-size:.72rem; font-weight:800; padding:.15rem .5rem; border-radius:50px; margin-left:6px; vertical-align:middle }
  .ana-growth.up { background:#dcfce7; color:#15803d }
  .ana-growth.down { background:#fee2e2; color:#b91c1c }
  .ana-toolbar { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:0 0 20px }
  .ana-toolbar form { display:flex; gap:8px; align-items:center }
  .ana-toolbar select { padding:7px 10px; border:1px solid var(--border); border-radius:8px; font-size:.85rem; background:var(--white) }
  .ana-funnel { display:flex; flex-wrap:wrap; gap:10px }
  .ana-funnel .fitem { flex:1; min-width:110px; border:1px solid var(--border); border-radius:10px; padding:10px 12px; text-align:center }
  .ana-funnel .fnum { font-size:1.25rem; font-weight:800 }
  .ana-funnel .flab { font-size:.72rem; color:var(--muted); text-transform:capitalize }
  .ana-note { font-size:.76rem; color:var(--muted); margin-top:10px }
</style>
<div class="admin-wrap">
  <%- include('../partials/admin-sidebar', { active: 'analytics', pendingCount: pendingCount }) %>
  <div class="admin-main">
    <div class="admin-title">Sales Analytics</div>
    <div class="admin-sub">
      Live from the full order history<% if (sum.first_sale) { %> — first sale <%= dateLabel(sum.first_sale) %>, latest <%= dateLabel(sum.last_sale) %><% } %>.
      Revenue counts <strong>paid</strong> orders only.
    </div>

    <!-- ── KPI cards ─────────────────────────────────────────────────────── -->
    <div class="stat-cards">
      <div class="stat-card"><div class="stat-label">All-time revenue</div><div class="stat-value">&#8377;<%= fmt(sum.revenue) %></div><div class="stat-icon">💰</div></div>
      <div class="stat-card"><div class="stat-label">Books sold (all-time)</div><div class="stat-value"><%= fmt(sum.units) %></div><div class="stat-icon">📚</div></div>
      <div class="stat-card"><div class="stat-label">Paid orders</div><div class="stat-value"><%= fmt(sum.orders) %></div><div class="stat-icon">🧾</div></div>
      <div class="stat-card"><div class="stat-label">Unique buyers</div><div class="stat-value"><%= fmt(sum.buyers) %></div><div class="stat-icon">👥</div></div>
      <div class="stat-card"><div class="stat-label">Avg order value</div><div class="stat-value">&#8377;<%= fmt2(sum.aov) %></div><div class="stat-icon">⚖️</div></div>
      <div class="stat-card">
        <div class="stat-label">This month (<%= ymLabel(thisMonth.ym) %>)</div>
        <div class="stat-value">&#8377;<%= fmt(thisMonth.revenue) %>
          <span class="ana-growth <%= growth >= 0 ? 'up' : 'down' %>"><%= growth >= 0 ? '▲' : '▼' %> <%= Math.abs(growth).toFixed(0) %>%</span>
        </div>
        <div class="ana-note"><%= fmt(thisMonth.units) %> books · <%= fmt(thisMonth.orders) %> orders · last month &#8377;<%= fmt(lastMonth.revenue) %></div>
      </div>
    </div>

    <!-- ── Toolbar: month filter + exports ───────────────────────────────── -->
    <div class="ana-toolbar">
      <form method="GET" action="/admin/analytics">
        <label for="ana-month" style="font-size:.82rem;color:var(--muted);font-weight:600">Book-wise month:</label>
        <select id="ana-month" name="month" onchange="this.form.submit()">
          <option value="">All time</option>
          <% months.slice().reverse().forEach(function(r){ %>
            <option value="<%= r.ym %>" <%= month === r.ym ? 'selected' : '' %>><%= ymLabel(r.ym) %></option>
          <% }); %>
        </select>
        <noscript><button class="btn btn-primary btn-sm" type="submit">Apply</button></noscript>
      </form>
      <span style="flex:1"></span>
      <a class="btn btn-ghost btn-sm" href="/admin/analytics?export=monthly">⬇ Monthly CSV</a>
      <a class="btn btn-ghost btn-sm" href="/admin/analytics?export=books<%= month ? '&month=' + month : '' %>">⬇ Book-wise CSV</a>
    </div>

    <% if (!months.length) { %>
      <div class="ana-card"><h3>No sales yet</h3>
        <p style="color:var(--muted);font-size:.9rem;margin:0">Analytics fills in automatically from the first approved (paid) order.</p>
      </div>
    <% } else { %>

    <!-- ── Product drill-down (when ?product=) ───────────────────────────── -->
    <% if (drill) { %>
      <div class="ana-card" style="margin-bottom:26px;border-color:#99f6e4">
        <h3>📖 <%= drill.product.title %> — month by month
          <a class="adm-link" style="float:right" href="/admin/analytics<%= month ? '?month=' + month : '' %>">✕ Close</a></h3>
        <% if (!drill.rows.length) { %>
          <p style="color:var(--muted);font-size:.9rem;margin:0">No paid sales for this book yet.</p>
        <% } else { const dMax = Math.max(1, ...drill.rows.map((r) => r.revenue)); %>
          <div class="ana-chart" style="height:120px">
            <% drill.rows.slice(-18).forEach(function(r){ %>
              <div class="ana-col" title="<%= ymLabel(r.ym) %>: ₹<%= fmt(r.revenue) %> · <%= r.units %> sold">
                <div class="ana-val">&#8377;<%= fmt(r.revenue) %></div>
                <div class="ana-bar" style="height:<%= Math.max(2, (r.revenue / dMax) * 100) %>%"></div>
                <div class="ana-lab"><%= ymLabel(r.ym) %></div>
              </div>
            <% }); %>
          </div>
          <div class="admin-table-wrap" style="margin-top:16px">
            <table class="admin-table">
              <thead><tr><th>Month</th><th>Units sold</th><th>Revenue</th></tr></thead>
              <tbody>
                <% drill.rows.slice().reverse().forEach(function(r){ %>
                  <tr><td><%= ymLabel(r.ym) %></td><td><%= fmt(r.units) %></td><td>&#8377;<%= fmt2(r.revenue) %></td></tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    <% } %>

    <!-- ── Monthly charts ────────────────────────────────────────────────── -->
    <div class="ana-grid2">
      <div class="ana-card">
        <h3>💰 Revenue by month <span style="font-weight:400;color:var(--muted);font-size:.78rem">(last <%= last12.length %> months)</span></h3>
        <div class="ana-chart">
          <% last12.forEach(function(r){ %>
            <div class="ana-col" title="<%= ymLabel(r.ym) %>: ₹<%= fmt(r.revenue) %> from <%= r.orders %> orders">
              <div class="ana-val">&#8377;<%= fmt(r.revenue) %></div>
              <div class="ana-bar" style="height:<%= Math.max(2, (r.revenue / maxRev) * 100) %>%"></div>
              <div class="ana-lab"><%= ymLabel(r.ym) %></div>
            </div>
          <% }); %>
        </div>
      </div>
      <div class="ana-card">
        <h3>📚 Books sold by month <span style="font-weight:400;color:var(--muted);font-size:.78rem">(last <%= last12.length %> months)</span></h3>
        <div class="ana-chart">
          <% last12.forEach(function(r){ %>
            <div class="ana-col" title="<%= ymLabel(r.ym) %>: <%= r.units %> books sold">
              <div class="ana-val"><%= fmt(r.units) %></div>
              <div class="ana-bar alt" style="height:<%= Math.max(2, (r.units / maxUnits) * 100) %>%"></div>
              <div class="ana-lab"><%= ymLabel(r.ym) %></div>
            </div>
          <% }); %>
        </div>
      </div>
    </div>

    <!-- ── Best sellers + categories ─────────────────────────────────────── -->
    <div class="ana-grid2">
      <div class="ana-card">
        <h3>🏆 Best-selling books<%= month ? ' — ' + ymLabel(month) : ' (all-time)' %></h3>
        <% if (!top10.length) { %><p style="color:var(--muted);font-size:.9rem;margin:0">No sales in this period.</p><% } %>
        <% top10.forEach(function(b, i){ %>
          <div class="ana-hbar-row">
            <div title="<%= b.title %>" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap">
              <strong><%= i + 1 %>.</strong> <a class="adm-link" href="/admin/analytics?product=<%= b.id %><%= month ? '&month=' + month : '' %>"><%= b.title %></a>
            </div>
            <div><div class="ana-hbar" style="width:<%= Math.max(2, (b.revenue / maxBookRev) * 100) %>%"></div></div>
            <div style="white-space:nowrap;font-weight:700">&#8377;<%= fmt(b.revenue) %> <span style="color:var(--muted);font-weight:400">· <%= b.units %> sold</span></div>
          </div>
        <% }); %>
      </div>
      <div class="ana-card">
        <h3>🗂️ Revenue by category (all-time)</h3>
        <% if (!categories.length) { %><p style="color:var(--muted);font-size:.9rem;margin:0">No sales yet.</p><% } %>
        <% const maxCatRev = Math.max(1, ...categories.map((c) => c.revenue)); %>
        <% categories.forEach(function(c){ %>
          <div class="ana-hbar-row">
            <div title="<%= c.category %>" style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap"><%= c.category %></div>
            <div><div class="ana-hbar cat" style="width:<%= Math.max(2, (c.revenue / maxCatRev) * 100) %>%"></div></div>
            <div style="white-space:nowrap;font-weight:700">&#8377;<%= fmt(c.revenue) %> <span style="color:var(--muted);font-weight:400">· <%= c.share.toFixed(0) %>%</span></div>
          </div>
        <% }); %>
        <h3 style="margin-top:22px">🚦 Order funnel (all-time)</h3>
        <div class="ana-funnel">
          <div class="fitem"><div class="fnum" style="color:#15803d"><%= fmt(funnel.paid) %></div><div class="flab">paid</div></div>
          <div class="fitem"><div class="fnum" style="color:#b45309"><%= fmt(funnel.pending) %></div><div class="flab">pending</div></div>
          <div class="fitem"><div class="fnum" style="color:#b91c1c"><%= fmt(funnel.rejected) %></div><div class="flab">rejected</div></div>
          <div class="fitem"><div class="fnum"><%= fmt(funnel.total) %></div><div class="flab">total orders</div></div>
          <div class="fitem"><div class="fnum" style="color:#0d9488"><%= funnel.conversion.toFixed(0) %>%</div><div class="flab">approval rate</div></div>
        </div>
        <div class="ana-note">Pending orders are buyer-claimed and UNVERIFIED until you approve them in <a class="adm-link" href="/admin/orders">Orders</a>.</div>
      </div>
    </div>

    <!-- ── Book-wise table ───────────────────────────────────────────────── -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin:4px 0 14px;flex-wrap:wrap;gap:8px">
      <h3 style="margin:0">📖 Book-wise sales<%= month ? ' — ' + ymLabel(month) : ' (all-time)' %></h3>
      <span style="font-size:.8rem;color:var(--muted)"><%= books.length %> books with sales · click a title for its month-by-month history</span>
    </div>
    <div class="admin-table-wrap" style="margin-bottom:26px">
      <table class="admin-table">
        <thead><tr><th>#</th><th>Book</th><th>Category</th><th>Price</th><th>Units sold</th><th>Revenue</th><th>Share</th><th>Last sale</th></tr></thead>
        <tbody>
          <% books.forEach(function(b, i){ %>
          <tr>
            <td><%= i + 1 %></td>
            <td><a class="adm-link" href="/admin/analytics?product=<%= b.id %><%= month ? '&month=' + month : '' %>"><%= b.title %></a>
              <div style="font-size:.72rem;color:var(--muted)">/product/<%= b.slug %><%= b.is_published ? '' : ' · UNPUBLISHED' %></div></td>
            <td><%= b.category %></td>
            <td>&#8377;<%= fmt2(b.price) %></td>
            <td><strong><%= fmt(b.units) %></strong></td>
            <td><strong>&#8377;<%= fmt2(b.revenue) %></strong></td>
            <td><%= b.share.toFixed(1) %>%</td>
            <td><%= dateLabel(b.last_sale) %></td>
          </tr>
          <% }); %>
          <% if (!books.length) { %><tr><td colspan="8" style="text-align:center;color:var(--muted)">No paid sales<%= month ? ' in ' + ymLabel(month) : '' %> yet.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <!-- ── Full monthly history ──────────────────────────────────────────── -->
    <div style="display:flex;justify-content:space-between;align-items:center;margin:4px 0 14px;flex-wrap:wrap;gap:8px">
      <h3 style="margin:0">📅 Monthly history (entire shop lifetime)</h3>
      <a class="btn btn-ghost btn-sm" href="/admin/analytics?export=monthly">⬇ Export CSV</a>
    </div>
    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead><tr><th>Month</th><th>Paid orders</th><th>Books sold</th><th>Revenue</th><th>Avg order</th><th>Buyers</th><th>New buyers</th></tr></thead>
        <tbody>
          <% months.slice().reverse().forEach(function(r){ %>
          <tr>
            <td><a class="adm-link" href="/admin/analytics?month=<%= r.ym %>"><%= ymLabel(r.ym) %></a><%= r.ym === thisYm ? ' ·' : '' %> <span style="color:var(--muted);font-size:.72rem"><%= r.ym === thisYm ? 'current' : '' %></span></td>
            <td><%= fmt(r.orders) %></td>
            <td><%= fmt(r.units) %></td>
            <td><strong>&#8377;<%= fmt2(r.revenue) %></strong></td>
            <td>&#8377;<%= fmt2(r.aov) %></td>
            <td><%= fmt(r.buyers) %></td>
            <td><%= fmt(r.new_buyers) %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
    </div>
    <div class="ana-note">Bundles count as one sale of the bundle product at the bundle price. Figures update the moment an order is approved.</div>

    <% } %>
  </div>
</div>
