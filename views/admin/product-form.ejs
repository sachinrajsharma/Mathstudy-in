<% locals.layout = 'layout' %>
<link href="https://cdn.quilljs.com/1.3.7/quill.snow.css" rel="stylesheet">
<style>
/* ── MathStudy Editor (Gutenberg-style) ────────────────────────────────── */
.mse-tabs{display:flex;gap:6px;align-items:center}
.mse-tab{border:1.5px solid #e2e8f0;background:#fff;color:#475569;font-weight:700;font-size:0.78rem;padding:5px 12px;border-radius:7px;cursor:pointer;line-height:1}
.mse-tab.active{background:#0f766e;border-color:#0f766e;color:#fff}
.mse-tab.mse-fs{font-size:0.95rem;padding:4px 9px}
/* editor canvas — clean writing surface like the WP block editor */
#pf-desc{background:#fff}
#pf-desc .ql-editor{min-height:340px;font-size:1.02rem;line-height:1.75;padding:22px 26px;color:#1f2937}
#pf-desc .ql-editor h2{font-size:1.35rem;margin:1em 0 .4em}
#pf-desc .ql-editor h3{font-size:1.12rem;margin:1em 0 .35em}
#pf-desc .ql-editor blockquote{border-left:4px solid #0f766e;background:#f0fdfa;padding:8px 14px;margin:10px 0}
.ql-toolbar.ql-snow{position:sticky;top:0;z-index:5;background:#fafafa;border-radius:8px 8px 0 0}
.ql-container.ql-snow{border-radius:0 0 8px 8px}
/* HTML source view */
.mse-code{width:100%;min-height:340px;resize:vertical;border:1.5px solid #e2e8f0;border-radius:8px;padding:16px 18px;font-family:Consolas,Menlo,monospace;font-size:0.86rem;line-height:1.6;color:#0f172a;background:#f8fafc;white-space:pre-wrap}
.mse-code:focus{outline:2px solid #0f766e;border-color:#0f766e}
/* status bar */
.mse-status{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-top:8px;font-size:0.8rem;color:#64748b;flex-wrap:wrap}
/* raw-HTML repair banner */
#mse-htmlbanner{display:none;align-items:center;justify-content:space-between;gap:10px;background:#fef3c7;border:1.5px solid #f59e0b;border-radius:8px;padding:9px 14px;margin-bottom:10px;font-size:0.87rem;color:#78350f;flex-wrap:wrap}
#mse-render-btn{background:#f59e0b;border:none;color:#3b1a05;font-weight:800;padding:7px 14px;border-radius:7px;cursor:pointer;font-size:0.82rem}
/* paste toast */
#mse-toast{position:fixed;bottom:26px;left:50%;transform:translateX(-50%);background:#0f766e;color:#fff;font-weight:700;font-size:0.86rem;padding:10px 20px;border-radius:30px;box-shadow:0 6px 20px rgba(0,0,0,.25);opacity:0;pointer-events:none;transition:opacity .25s;z-index:2000}
#mse-toast.show{opacity:1}
/* fullscreen (distraction-free) mode */
#mse-box.mse-full{position:fixed;inset:0;z-index:1500;margin:0;border-radius:0;overflow:auto;background:#fff;box-shadow:none}
#mse-box.mse-full .adm-box-b{max-width:900px;margin:0 auto;padding-bottom:60px}
#mse-box.mse-full #pf-desc .ql-editor{min-height:calc(100vh - 260px)}
#mse-box.mse-full .mse-code{min-height:calc(100vh - 240px)}
</style>
<div class="admin-wrap">
  <%- include('../partials/admin-sidebar', { active: 'products' }) %>
  <div class="admin-main">
    <div style="display:flex;gap:14px;align-items:center;margin-bottom:20px">
      <a href="/admin/products" class="btn btn-ghost btn-sm">&larr; Back</a>
      <div class="admin-title" style="margin:0"><%= product ? 'Edit Product' : 'Add New Product' %></div>
    </div>
    <% if (locals.error && error) { %><div class="alert alert-error" style="margin-bottom:16px"><%= error %></div><% } %>

    <form id="productForm" action="/admin/products/<%= product ? product.id + '/edit' : 'new' %>" method="POST" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <% if (product) { %><input type="hidden" name="existing_cover" value="<%= product.cover_image || '' %>"><% } %>
      <div class="adm-editor">

        <!-- ── Main column ── -->
        <div>
          <div class="adm-box">
            <div class="adm-box-b">
              <div class="adm-field">
                <label>Product title *</label>
                <input type="text" name="title" id="pf-title" value="<%= product ? product.title : '' %>" required placeholder="e.g. Case Studies — Class 9 Polynomials">
              </div>
              <div class="adm-field">
                <label>URL slug *</label>
                <input type="text" name="slug" id="pf-slug" value="<%= product ? product.slug : '' %>" required placeholder="case-studies-class-9-polynomials">
                <div class="hint">Used in the product URL: /shop/product/<b id="pf-slug-prev"><%= product ? product.slug : 'your-slug' %></b></div>
              </div>
            </div>
          </div>

          <div class="adm-box" id="mse-box">
            <div class="adm-box-h" style="display:flex;align-items:center;justify-content:space-between;gap:10px">
              <span>Description</span>
              <span class="mse-tabs">
                <button type="button" id="mse-visual-btn" class="mse-tab active">Visual</button>
                <button type="button" id="mse-code-btn" class="mse-tab">HTML</button>
                <button type="button" id="mse-fs-btn" class="mse-tab mse-fs" title="Fullscreen (distraction-free)">⛶</button>
              </span>
            </div>
            <div class="adm-box-b">
              <div id="mse-htmlbanner">
                <span>⚠️ This description looks like <b>raw HTML code</b> (tags showing as text).</span>
                <button type="button" id="mse-render-btn">Render it as formatted content</button>
              </div>
              <div id="pf-desc" class="adm-quill"><%- product && product.description ? product.description : '' %></div>
              <textarea id="pf-desc-code" class="mse-code" spellcheck="false" placeholder="&lt;p&gt;Write or paste raw HTML here — it is rendered on the product page exactly as valid HTML.&lt;/p&gt;" style="display:none"></textarea>
              <textarea name="description" id="pf-desc-input" hidden></textarea>
              <div class="mse-status">
                <span id="mse-count">0 words</span>
                <span class="hint" style="display:inline">Paste formatted text <b>or</b> raw HTML — both are detected and rendered. Use the <b>HTML</b> tab to edit the source directly.</span>
              </div>
              <div class="adm-field" style="margin-top:14px">
                <label>Short description <span class="hint" style="display:inline">(shown on product cards · max 300)</span></label>
                <textarea name="short_desc" rows="2" maxlength="300" placeholder="One or two lines for listing cards"><%= product ? product.short_desc || '' : '' %></textarea>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">Search engine optimisation</div>
            <div class="adm-box-b">
              <div class="adm-field">
                <label>Meta title <span class="hint" id="mt-count" style="display:inline"></span></label>
                <input type="text" name="meta_title" id="pf-metatitle" maxlength="70" value="<%= product ? product.meta_title || '' : '' %>" placeholder="Case Studies Class 9 Polynomials PDF — MathStudy.in">
              </div>
              <div class="adm-field">
                <label>Meta description <span class="hint" id="md-count" style="display:inline"></span></label>
                <textarea name="meta_desc" id="pf-metadesc" rows="2" maxlength="160" placeholder="Download Class 9 Polynomials case-study PDF with solutions. CBSE aligned, instant download."><%= product ? product.meta_desc || '' : '' %></textarea>
              </div>
            </div>
          </div>
        </div>

        <!-- ── Sidebar column ── -->
        <div>
          <div class="adm-box">
            <div class="adm-box-h">Publish</div>
            <div class="adm-box-b">
              <label class="adm-check"><input type="checkbox" name="is_published" value="1" <%= (!product || product.is_published) ? 'checked' : '' %>> Published (visible in shop)</label>
              <label class="adm-check"><input type="checkbox" name="is_featured" value="1" <%= (product && product.is_featured) ? 'checked' : '' %>> Featured on home page</label>
              <div class="adm-save-row">
                <button type="submit" class="btn btn-primary" style="flex:1;justify-content:center"><%= product ? 'Save changes' : 'Create product' %></button>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">Pricing</div>
            <div class="adm-box-b">
              <div class="adm-field"><label>Price (₹) *</label><input type="number" name="price" value="<%= product ? product.price : '' %>" required step="0.01" min="0" placeholder="49"></div>
              <div class="adm-field"><label>Original / MRP (₹) — shows a strike-through discount</label><input type="number" name="original_price" value="<%= product ? product.original_price || '' : '' %>" step="0.01" min="0" placeholder="99"></div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">Category</div>
            <div class="adm-box-b">
              <div class="adm-field">
                <select name="category_id">
                  <option value="">— Uncategorised —</option>
                  <% cats.forEach(function(c){ %><option value="<%= c.id %>" <%= (product && product.category_id == c.id) ? 'selected' : '' %>><%= c.name %></option><% }); %>
                </select>
                <div class="hint">Manage the list under <a href="/admin/categories">Categories</a>.</div>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">Product image</div>
            <div class="adm-box-b">
              <img id="pf-cover-prev" class="adm-cover-prev" src="<%= product && product.cover_image ? product.cover_image : '' %>" alt="" style="<%= product && product.cover_image ? '' : 'display:none' %>">
              <div class="adm-field" style="margin:0">
                <input type="file" name="cover_image" id="pf-cover" accept="image/jpeg,image/png,image/webp">
                <div class="hint">JPG / PNG / WEBP, up to 5MB. <% if (product && product.cover_image) { %>Leave empty to keep the current image.<% } %></div>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">🔒 Secure download</div>
            <div class="adm-box-b">
              <div class="adm-field" style="margin:0">
                <label>Google Drive link</label>
                <input type="url" name="download_url" value="<%= product ? product.download_url || '' : '' %>" placeholder="https://drive.google.com/file/d/FILE_ID/view">
                <div class="hint">Server-side only. The buyer gets it through a one-time tokenised link <b>after you approve payment</b> — never the raw URL.</div>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">📦 Bundle builder (optional)</div>
            <div class="adm-box-b">
              <%
                var bsel = [];
                try { bsel = product && product.bundle_items ? (Array.isArray(product.bundle_items) ? product.bundle_items : JSON.parse(product.bundle_items)) : []; } catch(e) { bsel = []; }
              %>
              <p class="hint" style="margin-top:0">Tick the e-books this product includes to sell it as a <b>discounted bundle</b>. After you approve a buyer's payment, they automatically receive a download link for <b>every ticked e-book</b>. Leave all unticked for a normal single e-book.</p>
              <input type="search" id="bundleSearch" placeholder="🔍 Type to filter e-books…" autocomplete="off"
                     style="width:100%;margin-bottom:8px;padding:8px 12px;border:1.5px solid #e2e8f0;border-radius:8px;font-size:0.88rem">
              <div id="bundleList" style="max-height:300px;overflow-y:auto;border:1.5px solid #e2e8f0;border-radius:8px;padding:8px 10px">
                <%
                  var _cands = (typeof candidates !== 'undefined' ? candidates : []);
                  // Ticked e-books first — so what's IN the bundle is always visible at the top.
                  var _inb  = _cands.filter(function(c){ return bsel.indexOf(c.id) > -1; });
                  var _outb = _cands.filter(function(c){ return bsel.indexOf(c.id) === -1; });
                %>
                <% if (_inb.length) { %>
                  <div class="bl-head" style="position:sticky;top:-8px;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;font-weight:800;font-size:0.78rem;letter-spacing:.04em;text-transform:uppercase;border-radius:6px;padding:5px 10px;margin:0 0 6px">✓ In this bundle (<%= _inb.length %>) — untick to remove</div>
                  <% _inb.forEach(function(c){ %>
                    <label class="bl-row" style="display:flex;align-items:center;gap:8px;padding:4px 2px;font-size:0.86rem;cursor:pointer;background:#f0fdf4;border-radius:6px">
                      <input type="checkbox" name="bundle_items" value="<%= c.id %>" data-price="<%= c.price %>" checked>
                      <span style="flex:1"><%= c.title.length > 70 ? c.title.substring(0,70)+'…' : c.title %><% if (!c.is_published) { %> <em style="color:#b45309">(draft)</em><% } %></span>
                      <span style="color:#64748b">&#8377;<%= parseFloat(c.price).toFixed(0) %></span>
                    </label>
                  <% }); %>
                  <div class="bl-head" style="background:#f8fafc;border:1px solid #e2e8f0;color:#64748b;font-weight:800;font-size:0.78rem;letter-spacing:.04em;text-transform:uppercase;border-radius:6px;padding:5px 10px;margin:8px 0 6px">All other e-books — tick to add</div>
                <% } %>
                <% _outb.forEach(function(c){ %>
                  <label class="bl-row" style="display:flex;align-items:center;gap:8px;padding:4px 2px;font-size:0.86rem;cursor:pointer">
                    <input type="checkbox" name="bundle_items" value="<%= c.id %>" data-price="<%= c.price %>">
                    <span style="flex:1"><%= c.title.length > 70 ? c.title.substring(0,70)+'…' : c.title %><% if (!c.is_published) { %> <em style="color:#b45309">(draft)</em><% } %></span>
                    <span style="color:#64748b">&#8377;<%= parseFloat(c.price).toFixed(0) %></span>
                  </label>
                <% }); %>
              </div>
              <div id="bundleMath" style="margin-top:10px;font-size:0.88rem;background:#f0fdfa;border:1.5px solid #99f6e4;border-radius:8px;padding:8px 12px;display:none">
                <b><span id="bmCount">0</span> e-books selected</b> · combined value <b>&#8377;<span id="bmTotal">0</span></b>
                · your bundle price <b>&#8377;<span id="bmPrice">0</span></b>
                · buyer saves <b style="color:#059669"><span id="bmSave">0</span>%</b>
                <div class="hint" style="margin-top:4px">Tip: set <b>Original / MRP</b> to the combined value so the shop shows the strike-through discount automatically.</div>
              </div>
            </div>
          </div>

          <div class="adm-box">
            <div class="adm-box-h">Details</div>
            <div class="adm-box-b">
              <div class="adm-field"><label>Grade</label><input type="text" name="grade" value="<%= product ? product.grade || '' : '' %>" placeholder="Class 9, Grade 5…"></div>
              <div class="adm-field"><label>Board</label><input type="text" name="board" value="<%= product ? product.board || '' : '' %>" placeholder="CBSE / ICSE / ISC"></div>
              <div class="adm-field" style="margin:0"><label>Page count</label><input type="number" name="page_count" value="<%= product ? product.page_count || '' : '' %>" min="1" placeholder="42"></div>
            </div>
          </div>

          <% if (product) { %>
          <div class="adm-box">
            <div class="adm-box-h">Local PDF (optional fallback)</div>
            <div class="adm-box-b">
              <p class="hint" style="margin-top:0">Only needed if you serve the file from this server instead of Drive. Max 50MB.</p>
              <input type="file" id="pdfFile" accept="application/pdf" style="width:100%;margin-bottom:8px">
              <button type="button" class="btn btn-ghost btn-sm" id="pdfBtn">Upload PDF</button>
              <% if (product.pdf_file) { %><p class="hint" style="color:var(--success)">Current: <%= product.pdf_file %></p><% } %>
              <div id="uploadStatus" class="hint"></div>
            </div>
          </div>
          <% } %>
        </div>
      </div>
    </form>
  </div>
</div>

<script src="https://cdn.quilljs.com/1.3.7/quill.min.js"></script>
<script>
(function(){
  // ── MathStudy Editor: Gutenberg-style rich text + HTML source view ──
  var quill = new Quill('#pf-desc', {
    theme: 'snow',
    placeholder: 'Write, or paste formatted text / raw HTML — everything renders correctly…',
    modules: { toolbar: [
      [{ header: [2, 3, false] }],
      ['bold','italic','underline','strike'],
      [{ color: [] }, { background: [] }],
      [{ script: 'sub' }, { script: 'super' }],
      [{ list: 'ordered' }, { list: 'bullet' }],
      [{ align: [] }],
      ['blockquote','code-block','link'],
      ['clean']
    ] }
  });

  var codeArea   = document.getElementById('pf-desc-code');
  var visualBtn  = document.getElementById('mse-visual-btn');
  var codeBtn    = document.getElementById('mse-code-btn');
  var fsBtn      = document.getElementById('mse-fs-btn');
  var banner     = document.getElementById('mse-htmlbanner');
  var descBox    = document.getElementById('pf-desc');
  var mode       = 'visual';

  // Anything with a real opening tag of a common element counts as HTML source.
  function looksLikeHtml(t){
    return /<\s*(p|div|ul|ol|li|h[1-6]|strong|em|b|i|u|a|br|table|tr|td|th|span|blockquote|img|pre|code|sup|sub)\b[^>]*>/i.test(t || '');
  }
  // Readable line breaks for the HTML tab.
  function prettyHtml(h){
    return (h || '')
      .replace(/></g, '>\n<')
      .replace(/\n<(li|strong|em|b|i|u|a|span|sup|sub|br)\b/g, '<$1')
      .replace(/(<\/(li|strong|em|b|i|u|a|span|sup|sub)>)\n/g, '$1');
  }
  function setQuillHtml(h){
    quill.setContents(quill.clipboard.convert(h), 'silent');
  }
  function currentHtml(){
    return mode === 'code' ? codeArea.value : quill.root.innerHTML;
  }

  function toast(msg){
    var t = document.getElementById('mse-toast');
    if (!t) { t = document.createElement('div'); t.id = 'mse-toast'; document.body.appendChild(t); }
    t.textContent = msg;
    t.classList.add('show');
    clearTimeout(t._h); t._h = setTimeout(function(){ t.classList.remove('show'); }, 3200);
  }

  // Visual ⇄ HTML tabs (like the WordPress Visual / Code editor).
  function showVisual(){
    if (mode === 'code') setQuillHtml(codeArea.value);
    mode = 'visual';
    codeArea.style.display = 'none';
    descBox.style.display = '';
    document.querySelector('.ql-toolbar').style.display = '';
    visualBtn.classList.add('active'); codeBtn.classList.remove('active');
    updateCount();
  }
  function showCode(){
    if (mode === 'visual') codeArea.value = prettyHtml(quill.root.innerHTML);
    mode = 'code';
    descBox.style.display = 'none';
    document.querySelector('.ql-toolbar').style.display = 'none';
    codeArea.style.display = 'block';
    codeBtn.classList.add('active'); visualBtn.classList.remove('active');
    codeArea.focus();
  }
  visualBtn.addEventListener('click', showVisual);
  codeBtn.addEventListener('click', showCode);

  // Fullscreen writing mode.
  fsBtn.addEventListener('click', function(){
    document.getElementById('mse-box').classList.toggle('mse-full');
  });
  document.addEventListener('keydown', function(e){
    if (e.key === 'Escape') document.getElementById('mse-box').classList.remove('mse-full');
  });

  // Smart paste: HTML source pasted into the VISUAL editor is rendered, not
  // shown as literal tags. (Copying code from Notepad/VS Code yields a plain
  // text flavour — or a text/html flavour with the tags entity-escaped.)
  quill.root.addEventListener('paste', function(e){
    var cd = e.clipboardData;
    if (!cd) return;
    var plain = cd.getData('text/plain');
    var rich  = cd.getData('text/html');
    var richIsCode = !rich || rich.indexOf('&lt;') !== -1 || /<(pre|code)\b/i.test(rich);
    if (plain && looksLikeHtml(plain) && richIsCode) {
      e.preventDefault(); e.stopImmediatePropagation();
      var sel = quill.getSelection(true);
      if (quill.getLength() <= 1) setQuillHtml(plain);
      else quill.clipboard.dangerouslyPasteHTML(sel ? sel.index : quill.getLength() - 1, plain);
      toast('HTML code detected — rendered as formatted content ✓');
    }
  }, true);

  // Repair banner: an existing description saved as escaped HTML (tags visible
  // as text) is detected on load and fixed with one click.
  function checkEscaped(){
    var plainText = quill.getText();
    var hasRealMarkup = descBox.querySelectorAll('ul,ol,h1,h2,h3,strong,em,blockquote,table').length > 0;
    if (!hasRealMarkup && looksLikeHtml(plainText)) banner.style.display = 'flex';
    else banner.style.display = 'none';
  }
  document.getElementById('mse-render-btn').addEventListener('click', function(){
    setQuillHtml(quill.getText());
    banner.style.display = 'none';
    toast('Description rendered as formatted content ✓');
    updateCount();
  });
  checkEscaped();

  // Word / character count.
  function updateCount(){
    var t = quill.getText().trim();
    var words = t ? t.split(/\s+/).length : 0;
    document.getElementById('mse-count').textContent = words + ' words · ' + t.length + ' characters';
  }
  quill.on('text-change', updateCount);
  updateCount();

  // Submit: whichever view is active is the source of truth.
  document.getElementById('productForm').addEventListener('submit', function(){
    document.getElementById('pf-desc-input').value = currentHtml();
  });

  // Auto slug from title
  function slugify(s){ return s.toLowerCase().replace(/[^\w\s-]/g,'').trim().replace(/\s+/g,'-').replace(/-+/g,'-'); }
  var title = document.getElementById('pf-title'), slug = document.getElementById('pf-slug'), slugPrev = document.getElementById('pf-slug-prev');
  var slugTouched = <%= product ? 'true' : 'false' %>;
  slug.addEventListener('input', function(){ slugTouched = true; slugPrev.textContent = slug.value || 'your-slug'; });
  title.addEventListener('input', function(){ if (!slugTouched) { slug.value = slugify(title.value); slugPrev.textContent = slug.value || 'your-slug'; } });

  // Cover preview
  var cover = document.getElementById('pf-cover'), prev = document.getElementById('pf-cover-prev');
  cover.addEventListener('change', function(){ if (cover.files[0]) { prev.src = URL.createObjectURL(cover.files[0]); prev.style.display = 'block'; } });

  // SEO counters
  function counter(el, out, max){ function u(){ out.textContent = el.value.length + '/' + max; } el.addEventListener('input', u); u(); }
  counter(document.getElementById('pf-metatitle'), document.getElementById('mt-count'), 70);
  counter(document.getElementById('pf-metadesc'), document.getElementById('md-count'), 160);

  // PDF upload (edit only)
  var pdfBtn = document.getElementById('pdfBtn');
  if (pdfBtn) pdfBtn.addEventListener('click', function(){
    var f = document.getElementById('pdfFile').files[0]; var st = document.getElementById('uploadStatus');
    if (!f) { st.textContent = 'Choose a PDF first.'; return; }
    var fd = new FormData(); fd.append('pdf_file', f); st.textContent = 'Uploading…';
    fetch('/admin/products/<%= product ? product.id : 0 %>/upload-pdf', { method:'POST', body: fd })
      .then(function(r){ return r.json(); }).then(function(d){ st.textContent = d.ok ? ('Uploaded: ' + d.filename) : ('Error: ' + d.error); st.style.color = d.ok ? 'var(--success)' : 'var(--danger)'; });
  });

  // Bundle builder: live discount maths
  var bundleBoxes = [].slice.call(document.querySelectorAll('#bundleList input[type="checkbox"]'));
  var priceInput = document.querySelector('input[name="price"]');
  function bundleMath() {
    var picked = bundleBoxes.filter(function(b){ return b.checked; });
    var wrap = document.getElementById('bundleMath');
    if (!wrap) return;
    if (!picked.length) { wrap.style.display = 'none'; return; }
    var total = picked.reduce(function(s,b){ return s + (parseFloat(b.dataset.price) || 0); }, 0);
    var mine = parseFloat(priceInput && priceInput.value) || 0;
    document.getElementById('bmCount').textContent = picked.length;
    document.getElementById('bmTotal').textContent = total.toFixed(0);
    document.getElementById('bmPrice').textContent = mine.toFixed(0);
    document.getElementById('bmSave').textContent = (total > 0 && mine > 0 && mine < total) ? Math.round((1 - mine/total) * 100) : 0;
    wrap.style.display = 'block';
  }
  bundleBoxes.forEach(function(b){ b.addEventListener('change', bundleMath); });
  // Live filter for the bundle list. Checked rows always stay visible so the
  // bundle contents never disappear while searching.
  var bundleSearch = document.getElementById('bundleSearch');
  if (bundleSearch) {
    bundleSearch.addEventListener('input', function () {
      var q = bundleSearch.value.trim().toLowerCase();
      [].slice.call(document.querySelectorAll('#bundleList .bl-row')).forEach(function (row) {
        var box = row.querySelector('input[type="checkbox"]');
        var hit = !q || row.textContent.toLowerCase().indexOf(q) > -1 || (box && box.checked);
        row.style.display = hit ? 'flex' : 'none';
      });
    });
  }
  if (priceInput) priceInput.addEventListener('input', bundleMath);
  bundleMath();
})();
</script>
