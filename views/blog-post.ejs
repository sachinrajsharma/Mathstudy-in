<% locals.layout = 'layout' %>
<%
const base    = locals.baseUrl || 'https://mathstudy.in';
const postUrl = base + '/blog/' + post.slug;
const readingTime = Math.max(1, Math.ceil((post.content || '').replace(/<[^>]+>/g,'').split(/\s+/).length / 220));
%>

<!-- Structured data -->
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org","@type":"BlogPosting",
  "headline": post.meta_title || post.title,
  "description": post.meta_desc || post.excerpt || '',
  "url": postUrl,
  "datePublished": post.created_at,
  "dateModified": post.updated_at || post.created_at,
  "author":{"@type":"Organization","name":"MathStudy.in","url": base},
  "publisher":{"@type":"Organization","name":"MathStudy.in","logo":{"@type":"ImageObject","url": base+"/images/logo.png"}},
  "image": post.cover_image || base+'/images/og-default.png',
  "mainEntityOfPage":{"@type":"WebPage","@id": postUrl}
}) %></script>

<!-- Breadcrumb schema -->
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org","@type":"BreadcrumbList",
  "itemListElement":[
    {"@type":"ListItem","position":1,"name":"Home","item":base},
    {"@type":"ListItem","position":2,"name":"Blog","item":base+"/blog"},
    {"@type":"ListItem","position":3,"name": post.title,"item": postUrl}
  ]
}) %></script>

<% if (locals.quiz && quiz.questions && quiz.questions.length) { %>
<!-- Quiz schema — tells Google this page is an interactive practice test -->
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org","@type":"Quiz",
  "name": quiz.title || (post.title + ' — Practice Quiz'),
  "about":{"@type":"Thing","name": quiz.about || post.title},
  "educationalLevel": quiz.level || (post.category || ''),
  "hasPart": quiz.questions.map(function(q){
    var correct = q.options[q.answer];
    return {
      "@type":"Question",
      "eduQuestionType":"Multiple choice",
      "text": q.q,
      "acceptedAnswer":{"@type":"Answer","text": correct},
      "suggestedAnswer": q.options.filter(function(o,i){return i!==q.answer;}).map(function(o){return {"@type":"Answer","text": o};})
    };
  })
}) %></script>
<% } %>

<% if (locals.faq && faq.length) { %>
<!-- FAQ schema -->
<script type="application/ld+json"><%- JSON.stringify({
  "@context":"https://schema.org","@type":"FAQPage",
  "mainEntity": faq.map(function(f){ return {"@type":"Question","name": f.q,"acceptedAnswer":{"@type":"Answer","text": f.a}}; })
}) %></script>
<% } %>

<!-- marked.js for markdown rendering -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/marked/9.1.6/marked.min.js"></script>

<!-- MathJax -->
<script>
window.MathJax = {
  tex: {
    inlineMath: [['$','$'],['\\(','\\)']],
    displayMath: [['$$','$$'],['\\[','\\]']],
    tags: 'ams'
  },
  options: { skipHtmlTags:['script','noscript','style','textarea','pre'] },
  startup: { typeset: false }
};
</script>
<script defer src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-chtml.js"></script>

<style>
/* ── Reading progress bar ─────────────────────────────────────────────────── */
#reading-progress{position:fixed;top:0;left:0;height:3px;width:0%;background:linear-gradient(90deg,#2563eb,#7c3aed);z-index:9999;transition:width .1s linear}

/* ── Content width (single source of truth for every band) ───────────────── */
:root{--post-wrap:1120px}

/* ── Post hero ───────────────────────────────────────────────────────────── */
.post-hero{background:linear-gradient(135deg,#0f172a 0%,#1e3a8a 60%,#1d4ed8 100%);padding:60px 0 0;color:#fff;position:relative;overflow:hidden}
.post-hero::before{content:'';position:absolute;inset:0;background:url("data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='0.03'%3E%3Ccircle cx='30' cy='30' r='20'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E");pointer-events:none}
.post-hero-inner{max-width:var(--post-wrap);margin:0 auto;padding:0 24px 48px;position:relative;z-index:1}
.post-breadcrumb{font-size:0.78rem;color:rgba(255,255,255,.55);margin-bottom:20px;display:flex;align-items:center;flex-wrap:wrap;gap:6px}
.post-breadcrumb a{color:rgba(255,255,255,.6);text-decoration:none;transition:color .15s}
.post-breadcrumb a:hover{color:#fff}
.post-breadcrumb span{color:rgba(255,255,255,.3)}
.post-cat-badge{display:inline-block;background:rgba(255,255,255,.15);backdrop-filter:blur(4px);color:#bfdbfe;padding:4px 14px;border-radius:99px;font-size:0.75rem;font-weight:700;letter-spacing:.04em;text-transform:uppercase;margin-bottom:18px;border:1px solid rgba(255,255,255,.1)}
.post-hero h1{font-size:clamp(1.6rem,4vw,2.6rem);font-weight:900;line-height:1.25;color:#fff;margin-bottom:18px;letter-spacing:-.01em}
.post-hero-excerpt{font-size:1.1rem;color:rgba(255,255,255,.78);line-height:1.65;margin-bottom:24px;max-width:680px}
.post-meta-bar{display:flex;flex-wrap:wrap;align-items:center;gap:16px;font-size:0.8rem;color:rgba(255,255,255,.5);padding:16px 0;border-top:1px solid rgba(255,255,255,.1)}
.post-meta-bar span{display:flex;align-items:center;gap:5px}
.post-meta-bar .meta-icon{opacity:.7;font-size:.9em}

/* ── Cover image strip ─────────────────────────────────────────── */
.post-cover-wrap{max-width:var(--post-wrap);margin:-32px auto 0;padding:0 24px;position:relative;z-index:2}
/* Covers are portrait product covers (e.g. 1410x2250). Show the WHOLE cover,
   centred like a book cover — never crop with object-fit:cover + fixed height,
   which slices off the top/bottom (and got worse as the column widened). */
.post-cover-wrap img{display:block;margin:0 auto;max-width:100%;max-height:560px;width:auto;height:auto;border-radius:16px;box-shadow:0 20px 60px rgba(0,0,0,.3)}

/* ── Article layout ───────────────────────────────────────────── */
.post-layout{max-width:var(--post-wrap);margin:0 auto;padding:48px 40px 80px;display:grid;grid-template-columns:minmax(0,1fr) 300px;gap:56px;align-items:start}
@media(max-width:1100px){.post-layout{padding:48px 32px 80px;gap:40px;grid-template-columns:minmax(0,1fr) 260px}}
@media(max-width:900px){.post-layout{grid-template-columns:1fr;gap:0}}

/* ── Article body typography ──────────────────────────────────── */
.post-body{min-width:0}
.blog-content{font-size:1.08rem;line-height:1.85;color:#1e293b;font-family:'Inter',sans-serif}
.blog-content>*+*{margin-top:1.2em}
.blog-content h1{font-size:1.9rem;font-weight:800;line-height:1.25;margin:2.4em 0 .8em;color:#0f172a;letter-spacing:-.01em}
.blog-content h2{font-size:1.5rem;font-weight:800;line-height:1.3;margin:2.2em 0 .7em;color:#0f172a;padding-bottom:8px;border-bottom:3px solid #dbeafe}
.blog-content h3{font-size:1.18rem;font-weight:700;margin:1.8em 0 .6em;color:#1e3a8a}
.blog-content h4{font-size:1.05rem;font-weight:700;margin:1.5em 0 .5em;color:#334155}
.blog-content p{margin-bottom:1.35em}
.blog-content a{color:#2563eb;text-decoration:underline;text-decoration-color:#bfdbfe;text-underline-offset:3px;transition:text-decoration-color .15s}
.blog-content a:hover{text-decoration-color:#2563eb}
.blog-content strong{font-weight:700;color:#0f172a}
.blog-content em{font-style:italic;color:#475569}
.blog-content ul{list-style:none;padding-left:0;margin-bottom:1.35em}
.blog-content ul li{position:relative;padding-left:20px;margin-bottom:8px}
.blog-content ul li::before{content:'';position:absolute;left:0;top:.7em;width:7px;height:7px;background:#2563eb;border-radius:50%}
.blog-content ol{padding-left:28px;margin-bottom:1.35em;counter-reset:item}
.blog-content ol li{margin-bottom:8px;padding-left:4px}
.blog-content blockquote{border-left:4px solid #2563eb;background:#eff6ff;padding:16px 22px;border-radius:0 10px 10px 0;margin:1.8em 0;color:#1e40af;font-size:1.02rem;position:relative}
.blog-content blockquote p{margin-bottom:0;color:#1e40af}
.blog-content code{background:#f1f5f9;padding:2px 7px;border-radius:5px;font-size:.88em;color:#c026d3;font-family:'JetBrains Mono','Fira Code','Courier New',monospace;white-space:nowrap}
.blog-content pre{background:#0f172a;color:#e2e8f0;padding:22px 24px;border-radius:12px;overflow-x:auto;margin:1.8em 0;position:relative}
.blog-content pre code{background:transparent;color:#e2e8f0;font-size:.875rem;white-space:pre;line-height:1.7;padding:0}
.blog-content img{max-width:100%;border-radius:12px;margin:1.8em 0;display:block;box-shadow:0 4px 20px rgba(0,0,0,.08)}
.blog-content hr{border:none;border-top:2px solid #f1f5f9;margin:2.4em 0}
.blog-content table{width:100%;border-collapse:collapse;margin:1.8em 0;font-size:.95rem;border-radius:10px;overflow:hidden;box-shadow:0 1px 6px rgba(0,0,0,.06)}
.blog-content th{background:#1e3a8a;color:#fff;font-weight:700;text-align:left;padding:12px 16px;font-size:.9rem}
.blog-content td{padding:11px 16px;border-bottom:1px solid #f1f5f9;vertical-align:top}
.blog-content tr:last-child td{border-bottom:none}
.blog-content tr:nth-child(even) td{background:#f8fafc}
.blog-content table{display:block;overflow-x:auto} /* mobile scroll */

/* Math styling */
.blog-content .MathJax,.blog-content mjx-container{font-size:1.05em}
.blog-content mjx-container[display="true"]{margin:1.5em auto;display:block;text-align:center;overflow-x:auto}
.math-block{text-align:center;margin:1.8em 0;overflow-x:auto;padding:8px 0}

/* FAQ section */
.blog-content h2:has(+h3){margin-bottom:.4em}

/* ── Sidebar ─────────────────────────────────────────────────── */
.post-sidebar{position:sticky;top:80px}
@media(max-width:900px){.post-sidebar{display:none}}
.sidebar-card{background:#fff;border:1.5px solid #e2e8f0;border-radius:14px;padding:20px;margin-bottom:16px}
.sidebar-card-title{font-size:0.72rem;font-weight:700;text-transform:uppercase;letter-spacing:.06em;color:#94a3b8;margin-bottom:14px}
.toc-list{list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:4px}
.toc-list a{font-size:0.82rem;color:#475569;text-decoration:none;padding:4px 8px;border-radius:6px;display:block;line-height:1.4;transition:background .12s,color .12s}
.toc-list a:hover,.toc-list a.active{background:#eff6ff;color:#2563eb}
.toc-list .toc-h3{padding-left:20px;font-size:0.78rem;color:#94a3b8}

/* ── Bottom share bar ─────────────────────────────────────────── */
.share-bar{max-width:var(--post-wrap);margin:0 auto;padding:0 24px 32px;display:flex;flex-wrap:wrap;align-items:center;justify-content:space-between;gap:14px;border-top:1px solid #f1f5f9;padding-top:28px}
.share-label{font-size:0.8rem;font-weight:700;color:#94a3b8;text-transform:uppercase;letter-spacing:.06em}
.share-btns{display:flex;gap:10px;flex-wrap:wrap}
.share-btn{display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border-radius:8px;font-size:0.82rem;font-weight:600;text-decoration:none;border:none;cursor:pointer;transition:opacity .15s;font-family:inherit}
.share-btn:hover{opacity:.85}
.share-btn-twitter{background:#e2e8f0;color:#334155}
.share-btn-whatsapp{background:#dcfce7;color:#15803d}
.share-btn-linkedin{background:#dbeafe;color:#1d4ed8}
.share-btn-copy{background:#f1f5f9;color:#475569}

/* ── CTA section ─────────────────────────────────────────────── */
.post-cta{max-width:var(--post-wrap);margin:0 auto 60px;padding:0 24px}
.cta-box{background:linear-gradient(135deg,#1e3a8a,#2563eb);border-radius:20px;padding:40px 44px;text-align:center;color:#fff;position:relative;overflow:hidden}
.cta-box::before{content:'';position:absolute;top:-40px;right:-40px;width:180px;height:180px;background:rgba(255,255,255,.06);border-radius:50%}
.cta-box::after{content:'';position:absolute;bottom:-30px;left:-30px;width:120px;height:120px;background:rgba(255,255,255,.04);border-radius:50%}
.cta-emoji{font-size:2.2rem;margin-bottom:10px;display:block}
.cta-box h3{font-size:1.4rem;font-weight:800;margin-bottom:10px;position:relative;z-index:1}
.cta-box p{color:rgba(255,255,255,.8);margin-bottom:22px;font-size:0.95rem;position:relative;z-index:1}
.cta-btn{display:inline-block;background:#fff;color:#1e3a8a;padding:12px 28px;border-radius:10px;font-weight:700;font-size:0.95rem;text-decoration:none;transition:transform .15s,box-shadow .15s;position:relative;z-index:1}
.cta-btn:hover{transform:translateY(-2px);box-shadow:0 8px 24px rgba(0,0,0,.2)}

/* ── Interactive MCQ quiz ─────────────────────────────────────── */
.mcq-quiz{max-width:var(--post-wrap);margin:8px auto 40px;padding:28px 24px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:18px}
.quiz-head{text-align:center;margin-bottom:22px}
.quiz-eyebrow{display:inline-block;background:#dbeafe;color:#1d4ed8;font-size:.72rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;padding:5px 12px;border-radius:99px;margin-bottom:10px}
.quiz-head h2{font-size:1.35rem;font-weight:800;color:#0f172a;margin:0 0 8px}
.quiz-head p{color:#475569;font-size:.92rem;max-width:600px;margin:0 auto;line-height:1.6}
.quiz-q{background:#fff;border:1px solid #e2e8f0;border-radius:12px;padding:16px 18px;margin-bottom:14px}
.quiz-q-text{font-weight:700;color:#0f172a;font-size:.98rem;margin:0 0 12px;line-height:1.5;display:flex;gap:9px;align-items:flex-start}
.quiz-num{flex:0 0 auto;width:24px;height:24px;background:#1e3a8a;color:#fff;border-radius:50%;font-size:.8rem;display:inline-flex;align-items:center;justify-content:center;margin-top:1px}
.quiz-fig{margin:2px 0 12px 33px}
.quiz-fig svg{max-width:260px;height:auto;background:#fff;border:1px solid #e2e8f0;border-radius:10px;padding:6px}
.quiz-opts{display:grid;gap:8px}
.quiz-opt{display:flex;align-items:center;gap:10px;padding:9px 12px;border:1.5px solid #e2e8f0;border-radius:9px;cursor:pointer;transition:border-color .12s,background .12s;font-size:.92rem;color:#334155}
.quiz-opt:hover{border-color:#93c5fd;background:#f0f7ff}
.quiz-opt input{accent-color:#1d4ed8;width:16px;height:16px;flex:0 0 auto}
.quiz-opt-letter{flex:0 0 auto;width:22px;height:22px;border:1px solid #cbd5e1;border-radius:6px;font-size:.78rem;font-weight:700;color:#64748b;display:inline-flex;align-items:center;justify-content:center}
.quiz-opt.is-correct{border-color:#16a34a;background:#f0fdf4}
.quiz-opt.is-correct .quiz-opt-letter{background:#16a34a;color:#fff;border-color:#16a34a}
.quiz-opt.is-wrong{border-color:#dc2626;background:#fef2f2}
.quiz-opt.is-wrong .quiz-opt-letter{background:#dc2626;color:#fff;border-color:#dc2626}
.quiz-explain{margin-top:10px;padding:10px 12px;background:#eff6ff;border-left:3px solid #2563eb;border-radius:6px;font-size:.86rem;color:#1e3a5f;line-height:1.55}
.quiz-actions{display:flex;gap:12px;justify-content:center;margin-top:6px;flex-wrap:wrap}
.quiz-submit{background:#1d4ed8;color:#fff;border:none;border-radius:10px;padding:12px 30px;font-weight:700;font-size:.95rem;cursor:pointer;transition:background .15s}
.quiz-submit:hover{background:#1e40af}
.quiz-reset{background:#fff;color:#1d4ed8;border:1.5px solid #1d4ed8;border-radius:10px;padding:12px 24px;font-weight:700;font-size:.92rem;cursor:pointer}
.quiz-result{margin-top:18px;text-align:center;font-weight:800;font-size:1.15rem;color:#0f172a;padding:16px;background:#fff;border-radius:12px;border:1px solid #e2e8f0}
.quiz-result .qr-score{font-size:1.8rem;color:#1d4ed8}
.quiz-result .qr-msg{display:block;font-size:.92rem;font-weight:600;color:#475569;margin-top:6px}

/* ── FAQ ──────────────────────────────────────────────────────── */
.post-faq{max-width:var(--post-wrap);margin:0 auto 40px;padding:0 24px}
.post-faq h2{font-size:1.35rem;font-weight:800;color:#0f172a;margin:0 0 16px}
.faq-item{border:1px solid #e2e8f0;border-radius:11px;margin-bottom:10px;background:#fff;overflow:hidden}
.faq-item summary{cursor:pointer;padding:15px 18px;font-weight:700;color:#0f172a;font-size:.96rem;list-style:none;position:relative}
.faq-item summary::-webkit-details-marker{display:none}
.faq-item summary::after{content:'+';position:absolute;right:18px;top:14px;font-size:1.3rem;color:#1d4ed8;font-weight:400}
.faq-item[open] summary::after{content:'\2212'}
.faq-a{padding:0 18px 16px;color:#475569;font-size:.92rem;line-height:1.7}

/* ── Per-blog product CTA ─────────────────────────────────────── */
.product-cta-wrap{max-width:var(--post-wrap);margin:0 auto 24px;padding:0 24px}
.product-cta{display:flex;gap:20px;align-items:center;background:#fff;border:2px solid #1d4ed8;border-radius:18px;padding:20px 22px}
.product-cta img{width:120px;height:auto;border-radius:8px;flex:0 0 auto;box-shadow:0 6px 18px rgba(0,0,0,.12)}
.product-cta-noimg{width:120px;height:150px;flex:0 0 auto;display:flex;align-items:center;justify-content:center;font-size:3rem;background:#eff6ff;border-radius:8px}
.product-cta-kicker{font-size:.72rem;font-weight:800;letter-spacing:.05em;text-transform:uppercase;color:#1d4ed8;margin-bottom:6px}
.product-cta-body h3{font-size:1.1rem;font-weight:800;color:#0f172a;margin:0 0 10px;line-height:1.35}
.product-cta-price{display:flex;align-items:baseline;gap:9px;margin-bottom:14px;flex-wrap:wrap}
.pc-now{font-size:1.5rem;font-weight:800;color:#0f172a}
.pc-was{color:#94a3b8;text-decoration:line-through;font-size:1rem}
.pc-off{background:#dcfce7;color:#15803d;font-size:.72rem;font-weight:800;padding:2px 8px;border-radius:6px}
.product-cta-btn{display:inline-block;background:#1d4ed8;color:#fff;font-weight:700;padding:11px 24px;border-radius:10px;text-decoration:none;font-size:.94rem;transition:background .15s}
.product-cta-btn:hover{background:#1e40af}
@media(max-width:560px){.product-cta{flex-direction:column;text-align:center}.product-cta-price{justify-content:center}}

/* ── Back link ────────────────────────────────────────────────── */
.post-back{max-width:var(--post-wrap);margin:0 auto;padding:0 24px 16px}
.post-back a{color:#2563eb;font-weight:600;font-size:0.875rem;text-decoration:none;display:inline-flex;align-items:center;gap:6px}
.post-back a:hover{text-decoration:underline}

/* ── Responsive ───────────────────────────────────────────────── */
@media(max-width:640px){
  .post-hero-inner{padding:0 16px 40px}
  .post-cover-wrap{padding:0 16px;margin-top:-20px}
  .post-layout{padding:32px 16px 60px}
  .blog-content{font-size:1rem}
  .blog-content h2{font-size:1.3rem}
  .blog-content h3{font-size:1.05rem}
  .cta-box{padding:28px 24px}
  .share-bar,.post-cta,.post-back{padding-left:16px;padding-right:16px}
}
</style>

<!-- Reading progress bar -->
<div id="reading-progress"></div>

<!-- ── HERO ─────────────────────────────────────────────────────────────────── -->
<div class="post-hero">
  <div class="post-hero-inner">

    <!-- Breadcrumb -->
    <nav class="post-breadcrumb" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>/</span>
      <a href="/blog">Blog</a>
      <% if (post.category) { %>
      <span>/</span>
      <a href="/blog?cat=<%= encodeURIComponent(post.category) %>"><%= post.category %></a>
      <% } %>
    </nav>

    <!-- Category badge -->
    <% if (post.category) { %>
    <a href="/blog?cat=<%= encodeURIComponent(post.category) %>" class="post-cat-badge"><%= post.category %></a>
    <% } %>

    <!-- Title -->
    <h1><%= post.title %></h1>

    <!-- Excerpt -->
    <% if (post.excerpt) { %>
    <p class="post-hero-excerpt"><%= post.excerpt %></p>
    <% } %>

    <!-- Meta bar -->
    <div class="post-meta-bar">
      <span>
        <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        <%= new Date(post.created_at).toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'}) %>
      </span>
      <span>
        <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <%= post.author || 'Vidara Editorial Team' %>
      </span>
      <span>
        <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <%= readingTime %> min read
      </span>
      <span>
        <svg class="meta-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
        <%= post.views %> views
      </span>
    </div>

  </div>
</div>

<!-- ── COVER IMAGE ────────────────────────────────────────────────────────────── -->
<% if (post.cover_image) { %>
<div class="post-cover-wrap">
  <img src="<%= post.cover_image %>" alt="<%= post.title %>" loading="eager">
</div>
<% } %>

<!-- ── ARTICLE ─────────────────────────────────────────────────────────────── -->
<div class="post-layout">

  <!-- Main content -->
  <% var _c = (post.content || '').trim(); var _isHtml = /^\s*</.test(_c); %>
  <article class="post-body" itemscope itemtype="https://schema.org/BlogPosting">
    <!-- HTML posts are server-rendered here (best for SEO); legacy markdown renders via JS -->
    <div class="blog-content" id="blog-content"><% if (_isHtml) { %><%- post.content %><% } %></div>
    <% if (!_isHtml) { %>
    <script type="text/markdown" id="raw-content"><%- _c.replace(/<\/script>/g, '<\\/script>') %></script>
    <% } %>
  </article>

  <!-- Sidebar ToC -->
  <aside class="post-sidebar" id="post-sidebar">
    <div class="sidebar-card">
      <div class="sidebar-card-title">In this article</div>
      <ul class="toc-list" id="toc-list">
        <!-- Built by JS -->
      </ul>
    </div>
  </aside>

</div>

<% if (locals.quiz && quiz.questions && quiz.questions.length) { %>
<!-- ── Interactive MCQ practice test ───────────────────────────────────────────── -->
<section class="mcq-quiz" id="mcqQuiz" aria-label="Practice quiz">
  <div class="quiz-head">
    <span class="quiz-eyebrow">✏️ Free online practice test</span>
    <h2><%= quiz.title || (post.title + ' — Quick Quiz') %></h2>
    <p><%= quiz.intro || ('Answer these ' + quiz.questions.length + ' questions to check what you have learned. Instant score and explanations — no sign-up needed.') %></p>
  </div>
  <form id="quizForm">
    <% quiz.questions.forEach(function(q, qi){ %>
    <div class="quiz-q" data-answer="<%= q.answer %>" data-qi="<%= qi %>">
      <p class="quiz-q-text"><span class="quiz-num"><%= qi+1 %></span> <%= q.q %></p>
      <% if (q.figure) { %><div class="quiz-fig"><%- q.figure %></div><% } %>
      <div class="quiz-opts">
        <% q.options.forEach(function(opt, oi){ %>
        <label class="quiz-opt">
          <input type="radio" name="q<%= qi %>" value="<%= oi %>">
          <span class="quiz-opt-letter"><%= String.fromCharCode(65+oi) %></span>
          <span class="quiz-opt-text"><%= opt %></span>
        </label>
        <% }) %>
      </div>
      <% if (q.explanation) { %><div class="quiz-explain" hidden><strong>Answer:</strong> <%= String.fromCharCode(65+q.answer) %>. <%= q.explanation %></div><% } %>
    </div>
    <% }) %>
    <div class="quiz-actions">
      <button type="submit" class="quiz-submit">Check my score</button>
      <button type="button" class="quiz-reset" id="quizReset" hidden>Try again</button>
    </div>
    <div class="quiz-result" id="quizResult" hidden></div>
  </form>
</section>
<% } %>

<% if (locals.ctaProduct && ctaProduct) { %>
<!-- ── Per-blog product CTA — placed right after the quiz (peak engagement), NOT
     after the FAQ, since many readers never scroll to the end ──────────────────── -->
<div class="product-cta-wrap">
  <div class="product-cta">
    <% if (ctaProduct.cover_image) { %><img src="<%= ctaProduct.cover_image %>" alt="<%= ctaProduct.title %> cover" loading="lazy">
    <% } else { %><div class="product-cta-noimg">📘</div><% } %>
    <div class="product-cta-body">
      <div class="product-cta-kicker">Practise on paper next</div>
      <h3><%= ctaProduct.title %></h3>
      <div class="product-cta-price">
        <span class="pc-now">&#8377;<%= parseFloat(ctaProduct.price).toFixed(0) %></span>
        <% if (ctaProduct.original_price && ctaProduct.original_price > ctaProduct.price) { %>
          <span class="pc-was">&#8377;<%= parseFloat(ctaProduct.original_price).toFixed(0) %></span>
          <span class="pc-off"><%= Math.round((1 - ctaProduct.price/ctaProduct.original_price)*100) %>% off</span>
        <% } %>
      </div>
      <a class="product-cta-btn" href="/shop/product/<%= ctaProduct.slug %>">Get the printable PDF &rarr;</a>
    </div>
  </div>
</div>
<% } %>

<% if (!(locals.ctaProduct && ctaProduct)) { %>
<!-- ── SHOP CTA (only when the blog has no specific product CTA) ───────────────── -->
<div style="max-width:var(--post-wrap);margin:0 auto 8px;padding:0 24px">
  <div style="background:linear-gradient(135deg,#0d9488,#0f766e);border-radius:16px;padding:26px 28px;color:#fff;text-align:center">
    <h3 style="font-size:1.3rem;font-weight:800;margin:0 0 8px;color:#fff">Get exam-ready faster with our e-books</h3>
    <p style="margin:0 0 18px;opacity:.95;font-size:.95rem">Chapter-wise notes, case studies, DPPs &amp; formula books — instant PDF download, from ₹7.</p>
    <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap">
      <a href="/shop" style="display:inline-flex;align-items:center;gap:8px;background:#fff;color:#0f766e;font-weight:700;padding:11px 24px;border-radius:10px;text-decoration:none">Browse the shop</a>
    </div>
  </div>
</div>
<% } %>

<% if (locals.faq && faq.length) { %>
<!-- ── FAQ (visible, matches FAQ schema) — after the CTA ────────────────────────── -->
<section class="post-faq" aria-label="Frequently asked questions">
  <h2>Frequently asked questions</h2>
  <% faq.forEach(function(f){ %>
  <details class="faq-item">
    <summary><%= f.q %></summary>
    <div class="faq-a"><%- f.a %></div>
  </details>
  <% }) %>
</section>
<% } %>

<!-- ── SHARE BAR ─────────────────────────────────────────────────────────────── -->
