       target="_blank" rel="noopener noreferrer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M20.52 3.449C12.831-3.984.106 1.407.101 11.893c0 2.096.549 4.14 1.595 5.945L.057 24l6.302-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.42-8.452z"/></svg>
      WhatsApp
    </a>
    <a class="share-btn share-btn-linkedin"
       href="https://www.linkedin.com/sharing/share-offsite/?url=<%= encodeURIComponent(postUrl) %>"
       target="_blank" rel="noopener noreferrer">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
      LinkedIn
    </a>
    <button class="share-btn share-btn-copy" onclick="copyLink()" id="copy-btn">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
      Copy link
    </button>
  </div>
</div>

<% if (!(locals.ctaProduct && ctaProduct)) { %>
<!-- ── CTA (generic — only when no per-blog product is set) ────────────────────── -->
<div class="post-cta">
  <div class="cta-box">
    <span class="cta-emoji">📚</span>
    <h3>Want ready-to-print practice sets?</h3>
    <p>Chapter-wise worksheets, case-study workbooks and full-length practice papers with step-by-step solutions — instant PDF download.</p>
    <a href="/shop" class="cta-btn">Browse Practice E-Books &rarr;</a>
  </div>
</div>
<% } %>

<script>
(function() {

// ── 1. Render markdown or HTML content ───────────────────────────────────────
var rawEl   = document.getElementById('raw-content');
var target  = document.getElementById('blog-content');
var raw     = rawEl ? rawEl.textContent.trim() : '';

function isHTML(str) {
  return /<[a-z][\s\S]*>/i.test(str);
}

function renderContent(str) {
  if (!str) { target.innerHTML = '<p style="color:#94a3b8">Content coming soon.</p>'; return; }

  if (isHTML(str)) {
    // Already stored as HTML (old posts)
    target.innerHTML = str;
  } else {
    // Markdown — protect math, parse, restore
    var mathStore = [];

    function protect(s) {
      return s
        // Display math $$...$$
        .replace(/\$\$([\s\S]*?)\$\$/g, function(m, p) {
          mathStore.push('\n<div class="math-block">\\[' + p + '\\]</div>\n');
          return '\n\nMATHPLACEHOLDER' + (mathStore.length - 1) + '\n\n';
        })
        // Inline math $...$  (not $$ and not escaped)
        .replace(/(?<!\$)\$(?!\$)([^\$\n]{1,300}?)(?<!\$)\$(?!\$)/g, function(m, p) {
          mathStore.push('\\(' + p + '\\)');
          return 'MATHPLACEHOLDER' + (mathStore.length - 1);
        });
    }

    var protected_md = protect(str);

    // Configure marked
    if (typeof marked !== 'undefined') {
      marked.setOptions({ breaks: true, gfm: true, smartLists: true });
      var html = marked.parse(protected_md);
      // Restore math
      html = html.replace(/MATHPLACEHOLDER(\d+)/g, function(m, i) {
        return mathStore[parseInt(i)];
      });
      target.innerHTML = html;
    } else {
      // marked not loaded — fallback: just convert ## headings manually
      target.innerHTML = str.replace(/\n/g, '<br>');
    }
  }

  // Typeset math
  if (window.MathJax && MathJax.typesetPromise) {
    MathJax.typesetPromise([target]).catch(function(){});
  } else {
    // MathJax not ready yet — wait for it
    document.addEventListener('MathJaxReadyToTypeset', function() {
      if (MathJax.typesetPromise) MathJax.typesetPromise([target]).catch(function(){});
    });
    setTimeout(function() {
      if (window.MathJax && MathJax.typesetPromise) {
        MathJax.typesetPromise([target]).catch(function(){});
      }
    }, 1500);
  }
}

// HTML posts are already server-rendered into #blog-content — only run the
// client-side renderer for legacy markdown (which ships a #raw-content store).
if (rawEl && raw) {
  renderContent(raw);
} else if (window.MathJax && MathJax.typesetPromise) {
  MathJax.typesetPromise([target]).catch(function(){});
}

// ── 2. Build table of contents from h2/h3 ────────────────────────────────────
function buildToC() {
  var tocList   = document.getElementById('toc-list');
  var sidebar   = document.getElementById('post-sidebar');
  if (!tocList) return;

  var headings = target.querySelectorAll('h2, h3');
  if (headings.length < 2) { if (sidebar) sidebar.style.display = 'none'; return; }

  headings.forEach(function(h, i) {
    var id = 'heading-' + i;
    h.id = id;
    var li = document.createElement('li');
    var a  = document.createElement('a');
    a.href = '#' + id;
    a.textContent = h.textContent;
    if (h.tagName === 'H3') a.className = 'toc-h3';
    a.addEventListener('click', function(e) {
      e.preventDefault();
      h.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
    li.appendChild(a);
    tocList.appendChild(li);
  });

  // Highlight active heading on scroll
  var tocLinks = tocList.querySelectorAll('a');
  var observer = new IntersectionObserver(function(entries) {
    entries.forEach(function(entry) {
      if (entry.isIntersecting) {
        tocLinks.forEach(function(l) { l.classList.remove('active'); });
        var link = tocList.querySelector('a[href="#' + entry.target.id + '"]');
        if (link) link.classList.add('active');
      }
    });
  }, { rootMargin: '-20% 0% -70% 0%' });

  headings.forEach(function(h) { observer.observe(h); });
}

// Build ToC after content + MathJax settle
setTimeout(buildToC, 500);

// ── 3. Reading progress bar ───────────────────────────────────────────────────
var bar = document.getElementById('reading-progress');
window.addEventListener('scroll', function() {
  var scrollTop  = window.scrollY || document.documentElement.scrollTop;
  var docHeight  = document.documentElement.scrollHeight - window.innerHeight;
  var pct        = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
  bar.style.width = Math.min(100, pct) + '%';
}, { passive: true });

// ── 4. Copy link ──────────────────────────────────────────────────────────────
window.copyLink = function() {
  var url = window.location.href;
  if (navigator.clipboard) {
    navigator.clipboard.writeText(url).then(function() {
      var btn = document.getElementById('copy-btn');
      if (btn) { btn.textContent = 'Copied!'; setTimeout(function(){ btn.innerHTML = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg> Copy link'; }, 2000); }
    });
  }
};

// ── 5. Interactive MCQ quiz: score, colour answers, reveal explanations ───────
var quizForm = document.getElementById('quizForm');
if (quizForm) {
  var quizEls   = Array.prototype.slice.call(quizForm.querySelectorAll('.quiz-q'));
  var resultEl  = document.getElementById('quizResult');
  var resetBtn  = document.getElementById('quizReset');

  quizForm.addEventListener('submit', function(e) {
    e.preventDefault();
    var score = 0, answered = 0;
    quizEls.forEach(function(qEl) {
      var correct = parseInt(qEl.getAttribute('data-answer'), 10);
      var picked  = qEl.querySelector('input:checked');
      var labels  = qEl.querySelectorAll('.quiz-opt');
      labels.forEach(function(l){ l.classList.remove('is-correct','is-wrong'); });
      labels[correct].classList.add('is-correct');
      if (picked) {
        answered++;
        var pi = parseInt(picked.value, 10);
        if (pi === correct) score++;
        else labels[pi].classList.add('is-wrong');
      }
      var ex = qEl.querySelector('.quiz-explain');
      if (ex) ex.hidden = false;
    });
    var total = quizEls.length;
    var pct = Math.round((score / total) * 100);
    var msg = pct === 100 ? 'Perfect! You have mastered this topic.'
            : pct >= 60   ? 'Good work — revise the ones you missed and try again.'
            : 'Keep practising — read the explanations above, then retry.';
    resultEl.innerHTML = 'You scored <span class="qr-score">' + score + '/' + total + '</span>'
      + '<span class="qr-msg">' + msg + '</span>';
    resultEl.hidden = false;
    resetBtn.hidden = false;
    resultEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
  });

  resetBtn.addEventListener('click', function() {
    quizForm.reset();
    quizEls.forEach(function(qEl) {
      qEl.querySelectorAll('.quiz-opt').forEach(function(l){ l.classList.remove('is-correct','is-wrong'); });
      var ex = qEl.querySelector('.quiz-explain'); if (ex) ex.hidden = true;
    });
    resultEl.hidden = true; resetBtn.hidden = true;
    document.getElementById('mcqQuiz').scrollIntoView({ behavior: 'smooth', block: 'start' });
  });
}

})();
</script>
