<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %></title>
<meta name="description" content="<%= locals.metaDesc || 'Premium math e-books for CBSE, JEE, ICSE. Grades 1-12, competitive exams. Instant PDF download.' %>">
<meta name="robots" content="index, follow">
<% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:title"       content="<%= title %>">
<meta property="og:description" content="<%= locals.metaDesc || '' %>">
<meta property="og:type"        content="<%= locals.ogType || 'website' %>">
<% if (locals.canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
<meta property="og:image"       content="<%= locals.ogImage || '/images/og-default.png' %>">
<meta property="og:site_name"   content="MathStudy.in">
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="<%= title %>">
<meta name="twitter:description" content="<%= locals.metaDesc || '' %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<%- locals.siteJsonLd || '' %>
<%- locals.jsonLd || '' %>
</head>
<body>

<!-- ── NAV ── -->
<nav>
  <div class="nav-inner">
    <a class="nav-logo" href="/">
      <div class="logo-badge">M</div>
      MathStudy<span style="color:var(--secondary)">.in</span>
    </a>
    <div class="nav-links">
      <a href="/shop">Shop</a>
      <a href="/shop/category/class-9-mathematics">Class 9</a>
      <a href="/shop/category/class-12-mathematics">Class 12</a>
      <a href="/shop/category/jee-mathematics">JEE</a>
      <a href="/shop/category/case-studies-class-8">Case Studies</a>
      <a href="/blog">Blog</a>
    </div>
    <div class="nav-right">
      <a href="/cart" class="nav-cart" title="Cart">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        Cart
        <span class="nav-cart-badge" style="display:<%= locals.cartCount > 0 ? 'flex' : 'none' %>"><%= locals.cartCount %></span>
      </a>
      <% if (locals.user && user) { %>
        <% if (['admin','super_admin'].includes(user.role)) { %>
          <a class="btn-login" href="/admin">Admin</a>
        <% } %>
        <a class="btn-login" href="/dashboard">My Orders</a>
        <form action="/auth/logout" method="POST" style="display:inline">
          <button class="btn-signup" type="submit">Log Out</button>
        </form>
      <% } else { %>
        <a class="btn-login" href="/auth/login">Log In</a>
        <a class="btn-signup" href="/auth/register">Sign Up Free</a>
      <% } %>
    </div>
    <button class="nav-burger" id="navBurger" aria-label="Open menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</nav>

<!-- Mobile drawer -->
<div class="nav-drawer" id="navDrawer">
  <button class="nav-drawer-close" id="navDrawerClose">&times;</button>
  <a href="/shop">Shop All</a>
  <a href="/shop/category/class-9-mathematics">Class 9</a>
  <a href="/shop/category/class-12-mathematics">Class 12</a>
  <a href="/shop/category/jee-mathematics">JEE</a>
  <a href="/shop/category/case-studies-class-8">Case Studies</a>
  <a href="/blog">Blog</a>
  <a href="/cart">Cart (<%= locals.cartCount %>)</a>
  <% if (locals.user && user) { %>
    <a href="/dashboard">My Orders</a>
  <% } else { %>
    <a href="/auth/login">Log In</a>
    <a href="/auth/register">Sign Up</a>
  <% } %>
</div>

<%- body %>

<!-- ── FOOTER ── -->
<footer>
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <h3>MathStudy.in</h3>
        <p>Premium math e-books for every Indian student. CBSE, ICSE, ISC, JEE, CAT and competitive exams. Instant PDF download after purchase.</p>
      </div>
      <div class="footer-col">
        <h4>Categories</h4>
        <a href="/shop/category/grade-1-math">Grade 1–5</a>
        <a href="/shop/category/grade-8-math">Grade 6–8</a>
        <a href="/shop/category/class-9-mathematics">Class 9–10</a>
        <a href="/shop/category/class-12-mathematics">Class 11–12</a>
        <a href="/shop/category/jee-mathematics">JEE Maths</a>
      </div>
      <div class="footer-col">
        <h4>Shop</h4>
        <a href="/shop">All Products</a>
        <a href="/shop/category/case-studies-class-8">Case Studies</a>
        <a href="/shop/category/competitive-exams">Competitive Exams</a>
        <a href="/cart">My Cart</a>
        <a href="/dashboard">My Orders</a>
      </div>
      <div class="footer-col">
        <h4>Company</h4>
        <a href="/about">About Us</a>
        <a href="/contact">Contact</a>
        <a href="/blog">Blog</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/terms">Terms &amp; Conditions</a>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; <%= new Date().getFullYear() %> MathStudy.in — Udgam Welfare Foundation</span>
      <span>Made with care for Indian students</span>
    </div>
  </div>
</footer>

<script src="/js/main.js" defer></script>
</body>
</html>
