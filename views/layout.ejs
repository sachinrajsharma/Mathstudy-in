          <a href="/shop/category/imo-class-4-math"><span class="dd-ic">🏅</span><span>IMO Class 4 Maths<span class="dd-sub">Olympiad worksheets &amp; sample papers</span></span></a>
          <a href="/shop/category/imo-class-5-math"><span class="dd-ic">🏅</span><span>IMO Class 5 Maths<span class="dd-sub">Olympiad worksheets &amp; sample papers</span></span></a>
          <a href="/shop/category/competitive-exams"><span class="dd-ic">🏆</span><span>Competitive Exams<span class="dd-sub">CAT, CUET &amp; more</span></span></a>
        </div>
      </div>
      <a href="/shop/case-studies">Case Studies</a>
      <a href="/blog">Blog</a>
      <a href="/support">Support</a>
    </div>
    <div class="nav-right">
      <a href="/cart" class="nav-cart" title="Cart">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
        Cart
        <span class="nav-cart-badge" style="display:<%= locals.cartCount > 0 ? 'flex' : 'none' %>"><%= locals.cartCount %></span>
      </a>
      <% if (locals.user && user) { %>
        <% if (['admin','super_admin'].includes(user.role)) { %>
          <a class="btn-login" href="/admin">Admin</a>
        <% } %>
        <a class="btn-login" href="/dashboard">My Orders</a>
        <form action="/auth/logout" method="POST" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button class="btn-signup" type="submit">Log Out</button>
        </form>
      <% } else { %>
        <a class="btn-login" href="/auth/login">Log In</a>
        <a class="btn-signup" href="/auth/register">Sign Up Free</a>
      <% } %>
    </div>
    <button class="nav-burger" id="navBurger" aria-label="Open menu">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
    </button>
  </div>
</nav>

