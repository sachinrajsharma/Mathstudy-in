<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<% if (locals.csrfToken) { %><meta name="csrf-token" content="<%= csrfToken %>"><% } %>
<title><%= title %></title>
<meta name="description" content="<%= locals.metaDesc || 'Premium math e-books for CBSE, JEE, ICSE. Grades 1-12, competitive exams. Instant PDF download.' %>">
<meta name="robots" content="index, follow">
<% if (locals.canonical) { %><link rel="canonical" href="<%= canonical %>"><% } %>
<meta property="og:title"       content="<%= title %>">
<meta property="og:description" content="<%= locals.metaDesc || '' %>">
<meta property="og:type"        content="<%= locals.ogType || 'website' %>">
<% if (locals.canonical) { %><meta property="og:url" content="<%= canonical %>"><% } %>
<%
  // Social crawlers ignore a relative image path, so always emit an absolute URL.
  const _img  = locals.ogImage || '/images/og-default.png';
  const _site = locals.SITE_URL || 'https://mathstudy.in';
  const ogImageAbs = /^https?:\/\//i.test(_img) ? _img : _site + (_img.charAt(0) === '/' ? _img : '/' + _img);
%>
<meta property="og:image"       content="<%= ogImageAbs %>">
<meta property="og:site_name"   content="MathStudy.in">
<meta name="twitter:card"        content="summary_large_image">
<meta name="twitter:title"       content="<%= title %>">
<meta name="twitter:description" content="<%= locals.metaDesc || '' %>">
<meta name="twitter:image"       content="<%= ogImageAbs %>">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/main.css">
<% if (locals.extraCss) { %><link rel="stylesheet" href="<%= extraCss %>"><% } %>
<%- locals.siteJsonLd || '' %>
<%- locals.jsonLd || '' %>
<!-- Add Search Console verification here when ready: <meta name="google-site-verification" content="TOKEN"> -->
<!-- Google Analytics 4 (live property) -->
<script async src="https://www.googletagmanager.com/gtag/js?id=G-YWL5E4YY59"></script>
<script>window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments);}gtag('js',new Date());gtag('config','G-YWL5E4YY59');</script>
</head>
