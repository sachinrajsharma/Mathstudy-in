APP_NAME="MathStudy API"
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_php_artisan_key_generate
APP_DEBUG=false
APP_URL=https://api.mathstudy.in

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=mathstudy
DB_USERNAME=mathstudy_user
DB_PASSWORD=YOUR_DB_PASSWORD

# Session / Cache
SESSION_DRIVER=file
CACHE_DRIVER=file
QUEUE_CONNECTION=sync

# Laravel Sanctum — frontend origin (Next.js)
SANCTUM_STATEFUL_DOMAINS=mathstudy.in,www.mathstudy.in
FRONTEND_URL=https://mathstudy.in
SESSION_DOMAIN=.mathstudy.in

# UPI Payment (direct, zero-fee)
UPI_ID=mathstudy@icici
UPI_NAME=mathstudy.in

# Signed download URLs (generate with: openssl rand -base64 48)
APP_SIGNED_URL_SECRET=REPLACE_WITH_48_CHAR_RANDOM_STRING
DOWNLOAD_TTL_MINUTES=15

# Webhook secret (from your payment processor)
PAYMENT_WEBHOOK_SECRET=REPLACE_WITH_WEBHOOK_SECRET

# Google Site Verification (from Google Search Console)
GOOGLE_SITE_VERIFICATION=
